REM Test advanced memory operations for Nova-16
CLRHOME
DISP "Memory Operations Test"

REM Declare variables
BASE_ADDR = 12288  REM 0x3000 in decimal
TEST_SIZE = 100
DEST_ADDR = 16384  REM 0x4000 in decimal
I = 0
VALUE = 0
ORIGINAL = 0
COPY = 0
ERRORS = 0

REM Test memory functions with 64KB address space
REM Fill memory with pattern
DISP "Filling memory with pattern"
FOR I = 0 TO TEST_SIZE - 1
  VALUE = I MOD 256
  MEMSET(BASE_ADDR + I, VALUE, 1)
END

REM Test memory copy
MEMCPY(DEST_ADDR, BASE_ADDR, TEST_SIZE)

REM Verify copy
DISP "Verifying memory copy"
ERRORS = 0
FOR I = 0 TO TEST_SIZE - 1
  ORIGINAL = MEMTEST(BASE_ADDR + I, BASE_ADDR + I, 1)
  COPY = MEMTEST(DEST_ADDR + I, DEST_ADDR + I, 1)
  IF ORIGINAL != COPY THEN
    ERRORS = ERRORS + 1
  END
END

IF ERRORS = 0 THEN
  DISP "Memory copy successful!"
ELSE
  DISP "Memory copy errors:", ERRORS
END

REM Test memory move (overlap)
MEMMOVE(BASE_ADDR + 10, BASE_ADDR, TEST_SIZE - 10)

DISP "Memory operations test complete!"
PAUSE
END