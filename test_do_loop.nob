REM Test DO/LOOP constructs
REM Tests basic DO/LOOP, DO WHILE/LOOP, DO UNTIL/LOOP

ClrHome
Disp "Testing DO/LOOP constructs"

REM Basic DO/LOOP
A = 0
DO
    A = A + 1
    Disp "Basic loop:", A
LOOP WHILE A < 3

Disp "Basic loop done"

REM DO WHILE/LOOP
B = 5
DO WHILE B > 0
    Disp "While loop:", B
    B = B - 1
LOOP

Disp "While loop done"

REM DO UNTIL/LOOP
C = 0
DO UNTIL C >= 3
    Disp "Until loop:", C
    C = C + 1
LOOP

Disp "Until loop done"

REM Nested DO/LOOP
X = 0
Y = 0
DO WHILE X < 2
    Y = 0
    DO WHILE Y < 2
        Disp "Nested:", X, Y
        Y = Y + 1
    LOOP
    X = X + 1
LOOP

Disp "Nested loops done"