REM Color Constants Test
REM Tests all named color constants

CLRHOME

REM Test all color constants by drawing pixels
Y = 0
X = 0

REM Grayscale
PXLON(X, Y, BLACK)
PXLON(X+1, Y, DARKGRAY)
PXLON(X+2, Y, GRAY)
PXLON(X+3, Y, LIGHTGRAY)
PXLON(X+4, Y, WHITE)

REM Reds
Y = Y + 1
PXLON(X, Y, DARKRED)
PXLON(X+1, Y, RED)
PXLON(X+2, Y, BRIGHTRED)
PXLON(X+3, Y, LIGHTRED)

REM Greens
Y = Y + 1
PXLON(X, Y, DARKGREEN)
PXLON(X+1, Y, GREEN)
PXLON(X+2, Y, BRIGHTGREEN)
PXLON(X+3, Y, LIGHTGREEN)

REM Blues
