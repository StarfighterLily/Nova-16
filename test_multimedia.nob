REM Sound and Advanced Graphics Test
REM Tests sound generation, advanced graphics operations, and multimedia features

CLRHOME

DISP "Testing sound and advanced graphics:"

REM Test basic sound generation
DISP "Playing sound sequence:"

FOR NOTE = 220 TO 880 STEP 110
    Sound(NOTE, 100, 64, 0)  REM Frequency, duration, volume, waveform
    PAUSE 50
NEXT NOTE

STOP  REM Stop all sounds

REM Test graphics patterns
DISP "Drawing graphics patterns:"

REM Checkerboard pattern
FOR X = 0 TO 255 STEP 8
    FOR Y = 0 TO 255 STEP 8
        IF (X / 8 + Y / 8) MOD 2 = 0
            COLOR = WHITE
        ELSE
            COLOR = BLACK
        END IF

        REM Fill 8x8 block
        FOR BX = 0 TO 7
            FOR BY = 0 TO 7
                PXLON(X + BX, Y + BY, COLOR)
            NEXT BY
        NEXT BX
    NEXT Y
NEXT X

PAUSE 200

REM Test line drawing
DISP "Drawing lines:"

REM Horizontal lines
FOR Y = 0 TO 255 STEP 32
    FOR X = 0 TO 255
        PXLON(X, Y, RED)
    NEXT X
NEXT Y

REM Vertical lines
FOR X = 0 TO 255 STEP 32
    FOR Y = 0 TO 255
        PXLON(X, Y, BLUE)
    NEXT Y
NEXT X

PAUSE 200

REM Test circle drawing at different sizes
DISP "Drawing circles:"

CENTERS = [50, 100, 150, 200]
RADII = [10, 20, 30, 40]
CIRCLE_COLORS = [GREEN, YELLOW, MAGENTA, CYAN]

FOR I = 0 TO 3
    CX = CENTERS[I]
    CY = 128
    R = RADII[I]
    CC = CIRCLE_COLORS[I]

    REM Draw filled circle (simple distance-based approach)
    FOR DX = -R TO R
        FOR DY = -R TO R
            DIST_SQ = DX * DX + DY * DY
            IF DIST_SQ <= R * R
                PX = CX + DX
                PY = CY + DY
                IF PX >= 0 AND PX < 256 AND PY >= 0 AND PY < 256
                    PXLON(PX, PY, CC)
                END IF
            END IF
        NEXT DY
    NEXT DX
NEXT I

PAUSE 200

REM Test sound with graphics synchronization
DISP "Synchronized audio-visual:"

FOR FREQ = 200 TO 800 STEP 50
    PLAY FREQ, 200  REM Start playing note

    REM Draw visual representation
    BAR_HEIGHT = (FREQ - 200) * 256 / 600
    FOR Y = 256 - BAR_HEIGHT TO 255
        FOR X = 0 TO 255
            PXLON(X, Y, RAMP(FREQ MOD 256))
        NEXT X
    NEXT Y

    PAUSE 100
NEXT FREQ

STOP

REM Test sprite-like animation (simulated)
DISP "Simple animation:"

SPRITE_X = 0
SPRITE_Y = 100
SPRITE_SIZE = 8

FOR FRAME = 0 TO 50
    REM Clear previous sprite position
    FOR X = 0 TO SPRITE_SIZE
        FOR Y = 0 TO SPRITE_SIZE
            PXLOFF(SPRITE_X + X, SPRITE_Y + Y)
        NEXT Y
    NEXT X

    REM Update position
    SPRITE_X = SPRITE_X + 2
    IF SPRITE_X > 256 - SPRITE_SIZE
        SPRITE_X = 0
    END IF

    REM Draw new sprite
    FOR X = 0 TO SPRITE_SIZE
        FOR Y = 0 TO SPRITE_SIZE
            IF (X + Y + FRAME) MOD 3 = 0
                PXLON(SPRITE_X + X, SPRITE_Y + Y, (FRAME * 5) MOD 256)
            END IF
        NEXT Y
    NEXT X

    PAUSE 20
NEXT FRAME

DISP "Sound and graphics tests completed!"
PAUSE