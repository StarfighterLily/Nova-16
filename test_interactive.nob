REM Interactive Test
REM Tests keyboard input, user interaction, and dynamic behavior

ClrHome
Disp "Interactive Test"
Disp "Keyboard Input Demo"

REM Initialize variables
SCORE = 0
LIVES = 3
GAME_RUNNING = 1
I = 0

REM Draw initial game state
Disp "Score:", SCORE
Disp "Lives:", LIVES
Disp "Press keys to interact!"
Disp "WASD to move, SPACE to action"

REM Game loop
While GAME_RUNNING
    REM Check for keyboard input
    KEY = KEYIN()
    KEY_AVAILABLE = KEYSTAT()

    If KEY_AVAILABLE Then
        REM Process key
        If KEY = 87 Then  REM 'W' key
            Disp "Moved UP"
            SCORE = SCORE + 1
        ElseIf KEY = 65 Then  REM 'A' key
            Disp "Moved LEFT"
            SCORE = SCORE + 1
        ElseIf KEY = 83 Then  REM 'S' key
            Disp "Moved DOWN"
            SCORE = SCORE + 1
        ElseIf KEY = 68 Then  REM 'D' key
            Disp "Moved RIGHT"
            SCORE = SCORE + 1
        ElseIf KEY = 32 Then  REM Spacebar
            Disp "ACTION!"
            SCORE = SCORE + 10
        ElseIf KEY = 27 Then  REM Escape
            GAME_RUNNING = 0
            Disp "Game Over!"
        Else
            Disp "Unknown key:", KEY
        EndIf

        REM Update display
        ClrHome
        Disp "Score"
        Disp SCORE
        Disp "Lives"
        Disp LIVES
        Disp "Last key"
        Disp KEY

        REM Visual feedback - draw something based on score
        For I = 0 To SCORE / 10
            If I < 25 Then  REM Don't go off screen
                PxlOn(I * 10, 100, 15)
            EndIf
        Next I
    EndIf

    REM Small delay to prevent too fast polling
    For DELAY = 0 To 1000
        REM Busy wait
    Next DELAY
WEnd

REM Final score display
ClrHome
Disp "Final Score:", SCORE
Disp "Thanks for playing!"

REM Test input statement
Disp "Enter your name:"
Input NAME
Disp "Hello,", NAME

REM Test conditional input validation
VALID_INPUT = 0
While NOT VALID_INPUT
    Disp "Enter a number (1-10):"
    Input NUM
    If NUM >= 1 AND NUM <= 10 Then
        VALID_INPUT = 1
        Disp "Valid input:", NUM
    Else
        Disp "Invalid! Try again."
    EndIf
WEnd

Disp "Interactive Test Complete"
Pause