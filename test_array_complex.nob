REM Test array literals and complex array indexing
ClrHome
Disp "Testing array literals and complex indexing"

REM Test array literal
A = [10, 20, 30, 40, 50]
Disp "Array literal created"

REM Test array access with complex index
I = 2 + 1
Val = A[I]  REM Should be 40
Disp "A[2+1] =", Val

REM Test array assignment with complex index
J = 1 + 1
A[J] = 99
Disp "A[1+1] set to 99"

REM Verify the assignment
Val2 = A[2]
Disp "A[2] =", Val2

REM Test list access with complex index
L1(1) = 100
L1(2) = 200
L1(3) = 300

K = 1 + 1
ListVal = L1(K)  REM Should be 200
Disp "L1(1+1) =", ListVal

Disp "Array and list complex indexing test complete"