REM Test keyboard input
REM Tests KEYIN, KEYSTAT, and keyboard buffer functions

ClrHome
Disp "Testing keyboard input"
Disp "Press keys to test input..."

REM Test KEYSTAT (check if key available)
A = KEYSTAT()
Disp "Initial keystat:", A

REM Test KEYIN (blocking read)
Disp "Press a key for KEYIN test:"
B = KEYIN()
Disp "KEYIN result:", B

REM Test multiple key reads
Disp "Press 3 keys quickly:"
For I = 1 To 3
    C = KEYIN()
    Disp "Key", I, ":", C
End

REM Test non-blocking with timeout simulation
Disp "Testing key buffer..."
Count = 0
For I = 1 To 10
    If KEYSTAT() <> 0 Then
        K = KEYIN()
        Disp "Buffered key:", K
        Count = Count + 1
    Else
        Disp "No key available"
    EndIf
    REM Small delay
    For J = 1 To 100
    End
End

Disp "Keys read:", Count
Disp "Keyboard test complete"