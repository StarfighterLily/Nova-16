REM Test new MIN/MAX functions
CLRHOME
DISP "Testing MIN/MAX functions"

REM Test MIN function
A = MIN(10, 20)
DISP "MIN(10, 20) = ", A

B = MIN(50, 25)
DISP "MIN(50, 25) = ", B

REM Test MAX function
C = MAX(10, 20)
DISP "MAX(10, 20) = ", C

D = MAX(50, 25)
DISP "MAX(50, 25) = ", D

REM Test with expressions
X = 15
Y = 30
E = MIN(X + 5, Y - 10)
DISP "MIN(X+5, Y-10) = ", E

F = MAX(X * 2, Y / 2)
DISP "MAX(X*2, Y/2) = ", F

DISP "MIN/MAX tests complete"
PAUSE
END