REM Color Graphics Test
REM Tests all graphics functions with color parameters

CLRHOME

REM Test PXLON with different colors
DISP "Testing PXLON with colors:"
FOR I = 0 TO 15
    COLOR_VAL = COLOR(I, 8)  REM Mid brightness for each ramp
    PXLON(I * 8, 10, COLOR_VAL)
NEXT I

REM Test PXLOFF
DISP "Testing PXLOFF:"
PXLON(50, 30, RED)
PXLOFF(50, 30)  REM Should turn pixel off (black)

REM Test PXLCHANGE
DISP "Testing PXLCHANGE:"
PXLON(60, 30, GREEN)
PXLCHANGE(60, 30)  REM Should invert color

REM Test LINE with colors
DISP "Testing LINE with colors:"
LINE(10, 50, 100, 50, BLUE)
LINE(10, 60, 100, 60, YELLOW)
LINE(10, 70, 100, 70, MAGENTA)

REM Test CIRCLE with colors
DISP "Testing CIRCLE with colors:"
CIRCLE(50, 100, 15, CYAN)
CIRCLE(50, 100, 10, ORANGE)

REM Test filled CIRCLE
DISP "Testing filled CIRCLE:"
CIRCLE(150, 100, 12, PURPLE, 1)  REM Filled circle

REM Test diagonal lines
DISP "Testing diagonal LINE:"
LINE(200, 50, 250, 100, LIME)
LINE(200, 100, 250, 50, PINK)

REM Test color gradients using loops
DISP "Testing color gradients:"
FOR X = 0 TO 50
    GRADIENT_COLOR = COLOR(0, X * 5 / 50)  REM Grayscale gradient
    PXLON(100 + X, 150, GRADIENT_COLOR)
NEXT X

FOR Y = 0 TO 20
    RAINBOW_COLOR = COLOR(Y * 15 / 20, 12)  REM Rainbow effect
    LINE(160, 170 + Y, 200, 170 + Y, RAINBOW_COLOR)
NEXT Y

REM Test color mixing with different operations
DISP "Testing color operations:"
BASE_COLOR = GREEN
PXLON(10, 200, BASE_COLOR)
PXLON(20, 200, COLOR(RAMP(BASE_COLOR), SHADE(BASE_COLOR) + 2))
PXLON(30, 200, COLOR(RAMP(BASE_COLOR) + 1, SHADE(BASE_COLOR)))

PAUSE