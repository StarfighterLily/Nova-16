REM Optimization Test
REM Tests constant folding and algebraic simplification

CLRHOME

REM Test constant folding: 5 + 10 should become 15 at compile time
A = 5 + 10
DISP "A = 5 + 10 = ", A

REM Test algebraic simplification: x * 0 should become 0
B = A * 0
DISP "B = A * 0 = ", B

REM Test multiplication by 1: should be optimized away
C = A * 1
DISP "C = A * 1 = ", C

REM Test addition with 0: should be optimized away
D = A + 0
DISP "D = A + 0 = ", D

END