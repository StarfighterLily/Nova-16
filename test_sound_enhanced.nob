REM Test enhanced sound features
REM Tests multiple simultaneous sounds, effects, and music

ClrHome
Disp "Testing enhanced sound"

REM Test basic sound
SA = 0x2000  REM Sound address
SF = 440     REM Frequency (A4 note)
SV = 128     REM Volume
SW = 0       REM Waveform (square wave)
SPLAY        REM Start playback

Disp "Basic sound playing"

REM Test multiple simultaneous sounds
REM Sound channel 1
SA = 0x2100
SF = 660     REM E5 note
SV = 96
SW = 1       REM Triangle wave
SPLAY

REM Sound channel 2
SA = 0x2200
SF = 880     REM A5 note
SV = 64
SW = 2       REM Sawtooth wave
SPLAY

Disp "Multiple sounds playing"

REM Test sound effects
REM Drum effect - low frequency burst
SA = 0x2300
SF = 100
SV = 200
SW = 3       REM Noise
SPLAY

REM Test music sequence (simple)
Notes = [262,294,330,349,392,440,494,523]  REM C major scale
For I = 1 To 8
    SA = 0x2000 + (I * 0x100)
    SF = Notes(I)
    SV = 128
    SW = 0
    SPLAY
    REM Small delay between notes
    For J = 1 To 500
    End
End

Disp "Sound sequence complete"

REM Test volume changes
For V = 255 To 0 Step -10
    SV = V
    For J = 1 To 100  REM Short delay
    End
End

Disp "Enhanced sound test complete"