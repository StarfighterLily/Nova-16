REM Test RIGHT, MID, INSTR string functions
ClrHome
Disp "Testing RIGHT, MID, INSTR functions"

REM Test RIGHT function
Str1 = "Hello World"
Str2 = RIGHT(Str1, 5)
Disp "RIGHT('Hello World', 5):", Str2

REM Test MID function
Str3 = MID(Str1, 6, 5)
Disp "MID('Hello World', 6, 5):", Str3

REM Test INSTR function
Pos = INSTR(Str1, "World")
Disp "INSTR('Hello World', 'World'):", Pos

Pos2 = INSTR(Str1, "xyz")
Disp "INSTR('Hello World', 'xyz'):", Pos2

Disp "String functions test complete"