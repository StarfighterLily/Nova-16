{
  "regions": [
    {"name": "validation_pixels", "x": 195, "y": 0, "width": 20, "height": 220, "description": "Area where validation pixels are drawn (green=pass, red=fail)"},
    {"name": "color_display", "x": 0, "y": 0, "width": 190, "height": 190, "description": "Main display area for color tests"},
    {"name": "status_indicators", "x": 0, "y": 195, "width": 190, "height": 20, "description": "Status indicator area"}
  ],
  "layers": [0, 1, 2, 3, 4, 5, 6, 7],
  "verbose": true,
  "export": true,
  "check_interval": 10,
  "color_analysis": {
    "enabled": true,
    "track_unique_colors": true,
    "detect_validation_pixels": true,
    "validation_green_range": [36, 43],
    "validation_red_range": [20, 27],
    "expected_color_ranges": {
      "named_constants": [0, 15, 20, 36, 52, 68, 84, 100, 116, 132, 148, 164, 180, 196, 212, 228, 244],
      "function_outputs": "all",
      "graphics_operations": "all"
    }
  },
  "pixel_patterns": {
    "validation_success_pattern": {
      "description": "Green pixels indicating test success",
      "color_range": [36, 43],
      "region": "validation_pixels",
      "expected_count": "at_least_1"
    },
    "validation_failure_pattern": {
      "description": "Red pixels indicating test failure",
      "color_range": [20, 27],
      "region": "validation_pixels",
      "expected_count": "zero"
    },
    "color_ramp_pattern": {
      "description": "Sequential color ramps in display area",
      "color_range": [0, 255],
      "region": "color_display",
      "expected_distribution": "ramp_like"
    }
  }
}