REM Test advanced sound features for Nova-16
CLRHOME
DISP "Advanced Sound Test"

REM Declare variables
CHANNEL = 0
FREQ = 0
VOL = 0
WAVE = 0
I = 0
F = 0
V = 0

REM Test multi-channel sound (up to 8 channels)
FOR CHANNEL = 0 TO 7
  FREQ = 220 + (CHANNEL * 110)  REM Different frequencies
  VOL = 128 + (CHANNEL * 16)    REM Different volumes
  WAVE = CHANNEL MOD 4           REM Different waveforms
  DISP "Channel", CHANNEL, "playing at", FREQ, "Hz"
  SOUND(FREQ, 500, VOL, WAVE)
END

REM Test sound functions
TEST_FREQ = 440
TEST_VOL = 200
TEST_WAVE = 2
SOUND(TEST_FREQ, 1000, TEST_VOL, TEST_WAVE)

REM Test programmatic sound generation
DISP "Generating sound pattern"
FOR I = 0 TO 20
  F = 200 + (I * 20)
  V = 255 - (I * 10)
  SOUND(F, 100, V, 0)
END

DISP "Sound test complete!"
PAUSE
END