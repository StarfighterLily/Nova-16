REM Color Functions Test
REM Tests COLOR(), RAMP(), and SHADE() functions

CLRHOME

REM Test COLOR() function - create colors from ramps and shades
DISP "Testing COLOR() function:"

FOR R = 0 TO 15
    FOR S = 0 TO 15 STEP 5  REM Test every 5th shade
        C = COLOR(R, S)
        X = S * 4
        Y = R * 4
        PXLON(X, Y, C)
    NEXT S
NEXT R

REM Test RAMP() and SHADE() extraction functions
DISP "Testing RAMP() and SHADE() functions:"

DIM T(8)
T = [BLACK, RED, GREEN, BLUE, YELLOW, MAGENTA, CYAN, WHITE]
Y = 140

FOR I = 0 TO 7
    C = T[I]
    R = RAMP(C)
    S = SHADE(C)

    DISP "Color " + STR(I) + ": " + STR(C)
    DISP "  RAMP: " + STR(R) + " (expected: " + STR(I) + ")"
    DISP "  SHADE: " + STR(S)

    REM Draw a test pixel with the extracted color
    PXLON(200 + I*10, Y, C)
    Y = Y + 20
NEXT I

REM Test round-trip: create color, extract components, recreate
DISP "Testing round-trip conversion:"
O = COLOR(7, 11)  REM Cyan ramp, shade 11
E = RAMP(O)
F = SHADE(O)
N = COLOR(E, F)

DISP "Original: " + STR(O)
DISP "Ramp: " + STR(E) + ", Shade: " + STR(F)
DISP "Recreated: " + STR(N)
DISP "Match: " + STR(O = N)

REM Draw comparison pixels
PXLON(10, 200, O)
PXLON(20, 200, N)

PAUSE