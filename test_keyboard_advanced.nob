REM Test keyboard input functions
ClrHome
Disp "Testing keyboard functions"
Disp "Note: This test runs headlessly, so KEYIN/KEYSTAT will return 0"

REM Test KEYSTAT function
KeyAvailable = KEYSTAT()
Disp "KEYSTAT() =", KeyAvailable

REM Test KEYIN function
KeyPressed = KEYIN()
Disp "KEYIN() =", KeyPressed

REM Test in a loop (will timeout after 10000 cycles)
Disp "Testing keyboard polling..."
For I = 1 To 10
    If KEYSTAT() = 1 Then
        K = KEYIN()
        Disp "Key pressed:", K
        Break
    EndIf
    Disp "No key available, cycle", I
End

Disp "Keyboard functions test complete"