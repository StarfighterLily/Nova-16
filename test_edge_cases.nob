REM Error Conditions and Edge Cases Test
REM Tests error handling, boundary conditions, and edge cases

CLRHOME

DISP "Testing error conditions and edge cases:"

REM Test division by zero handling (should not crash)
DISP "Testing division by zero handling:"
A = 10
B = 0

REM This should be handled gracefully
IF B = 0
    DISP "Division by zero avoided"
ELSE
    RESULT = A / B
    DISP "Division result: " + STR(RESULT)
END IF

REM Test array bounds (simulated - our arrays are fixed size)
DISP "Testing array operations:"
TEST_ARRAY = [1, 2, 3, 4, 5]

FOR I = 0 TO 4
    IF I >= 0 AND I <= 4
        VAL = TEST_ARRAY[I]
        DISP "Array[" + STR(I) + "] = " + STR(VAL)
    END IF
NEXT I

REM Test very large numbers (within 16-bit limits)
DISP "Testing large numbers:"
BIG_NUM = 32767  REM Max 16-bit signed
DISP "Big number: " + STR(BIG_NUM)

NEG_NUM = -32768  REM Min 16-bit signed
DISP "Negative number: " + STR(NEG_NUM)

REM Test color bounds
DISP "Testing color bounds:"
FOR C = 0 TO 255 STEP 25
    IF C >= 0 AND C <= 255
        PXLON(10 + C / 25 * 5, 200, C)
    END IF
NEXT C

REM Test loop bounds
DISP "Testing loop bounds:"
FOR I = 10 TO 0 STEP -1
    IF I >= 0 AND I <= 10
        X = 50 + (10 - I) * 5
        PXLON(X, 220, GREEN)
    END IF
NEXT I

REM Test conditional complexity
DISP "Testing complex conditionals:"
SCORE = 75

IF SCORE >= 90
    GRADE = "A"
ELSE
    IF SCORE >= 80
        GRADE = "B"
    ELSE
        IF SCORE >= 70
            GRADE = "C"
        ELSE
            GRADE = "F"
        END IF
    END IF
END IF

DISP "Score: " + STR(SCORE) + ", Grade: " + GRADE

REM Test graphics bounds
DISP "Testing graphics bounds:"
FOR X = -5 TO 260 STEP 10
    FOR Y = -5 TO 260 STEP 10
        IF X >= 0 AND X < 256 AND Y >= 0 AND Y < 256
            PXLON(X, Y, BLUE)
        END IF
    NEXT Y
NEXT X

DISP "All edge case tests completed!"
PAUSE