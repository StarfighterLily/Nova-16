// Liveness Analysis Test
// This program tests if registers are freed immediately after use

// Test 1: Simple nested expression
x = (1 + 2) * (3 + 4)

// Test 2: Complex nested expression
y = ((5 + 6) * (7 + 8)) + ((9 + 10) * (11 + 12))

// Test 3: Function call with multiple arguments
z = MAX(MIN(1, 2), MIN(3, 4))

// Test 4: Multiple uses in sequence
a = 100
b = 200
c = a + b
d = a * 2
e = b / 2
