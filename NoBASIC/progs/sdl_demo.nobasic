' NoBASIC SDL Graphics Demo
' Demonstrates the 256x256 window scaled 3x using SDL

' Initialize graphics (this will be called automatically)
ClrDraw

' Draw a diagonal line
For I = 0 To 255
    PxlOn(I, I, 15)  ' White pixels
Next

' Draw some circles
Circle(128, 128, 50, 10)  ' Red circle
Circle(64, 64, 30, 12)    ' Green circle
Circle(192, 64, 30, 14)   ' Blue circle

' Draw some lines
Line(0, 0, 255, 255, 11)   ' Yellow line
Line(255, 0, 0, 255, 11) ' Yellow line

' Draw text
Text(10, 10, "NoBASIC SDL Demo!", 15)

' Present the frame
Pause