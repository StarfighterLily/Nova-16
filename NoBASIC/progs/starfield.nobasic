Struct stext color toggle End

stext.color = 0x10
stext.toggle = 0

SetLayer(1)
For x = 0 to 40
    For y = 0 to 40
        PxlOn(rnd(), rnd(), rndr(0x01, 0x04))
    Next
Next
ScrRotate(1,0)

SetLayer(2)
For x = 0 to 20
    For y = 0 to 20
        PxlOn(rnd(), rnd(), rndr(0x05, 0x09))
    Next
Next
ScrRotate(1,1)

SetLayer(3)
For x = 0 to 12
    For y = 0 to 12
        PxlOn(rnd(), rnd(), rndr(0x0A, 0x0F))
    Next
Next
ScrRotate(1,2)

Function scrollBG()
    SetLayer(1)
    ScrRoll(0, 1)
    SetLayer(2)
    ScrRoll(0, 2)
    SetLayer(3)
    ScrRoll(0, 3)
End

Function flashText()
    SetLayer(4)
    If stext.toggle = 0 Then
        stext.color = stext.color + 1
        If stext.color > 31 Then
            stext.color = 31
            stext.toggle = 1
        End
    End
    If stext.toggle = 1 Then
        stext.color = stext.color - 1
        If stext.color < 16 Then
            stext.color = 16
            stext.toggle = 0
        End
    End
    Text( 80, 120, "StarField", stext.color )
    For x = 0 to 25
        For y = 0 to 25
        Next
    Next
End

While 1
    scrollBG()
    flashText()
    For x = 0 to 25
        For y = 0 to 25
        Next
    Next
End