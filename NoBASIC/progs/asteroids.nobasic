// Asteroids clone for Nova-16 in NoBASIC
// Uses pixel graphics on multiple layers
// Ship: triangle drawn with Line()
// Asteroids: circles via Circle()
// Bullets: fast pixel projectiles

// ===== STRUCTS =====
Struct Ship x y dx dy angle thrust lives invuln counter score End

// ===== CONSTANTS =====
MAX_ASTEROIDS = 12
MAX_BULLETS = 5

// ===== GLOBAL STATE =====
GLOBAL gameOver, wave
GLOBAL b1_active, b1_x, b1_y, b1_dx, b1_dy, b1_life
GLOBAL b2_active, b2_x, b2_y, b2_dx, b2_dy, b2_life
GLOBAL b3_active, b3_x, b3_y, b3_dx, b3_dy, b3_life
GLOBAL b4_active, b4_x, b4_y, b4_dx, b4_dy, b4_life
GLOBAL b5_active, b5_x, b5_y, b5_dx, b5_dy, b5_life
GLOBAL a1_active, a1_x, a1_y, a1_dx, a1_dy, a1_size
GLOBAL a2_active, a2_x, a2_y, a2_dx, a2_dy, a2_size
GLOBAL a3_active, a3_x, a3_y, a3_dx, a3_dy, a3_size
GLOBAL a4_active, a4_x, a4_y, a4_dx, a4_dy, a4_size
GLOBAL a5_active, a5_x, a5_y, a5_dx, a5_dy, a5_size
GLOBAL a6_active, a6_x, a6_y, a6_dx, a6_dy, a6_size
GLOBAL a7_active, a7_x, a7_y, a7_dx, a7_dy, a7_size
GLOBAL a8_active, a8_x, a8_y, a8_dx, a8_dy, a8_size
GLOBAL a9_active, a9_x, a9_y, a9_dx, a9_dy, a9_size
GLOBAL a10_active, a10_x, a10_y, a10_dx, a10_dy, a10_size
GLOBAL a11_active, a11_x, a11_y, a11_dx, a11_dy, a11_size
GLOBAL a12_active, a12_x, a12_y, a12_dx, a12_dy, a12_size

// ===== INIT SHIP =====
Ship.x = 128
Ship.y = 128
Ship.dx = 0
Ship.dy = 0
Ship.angle = 0
Ship.thrust = 0
Ship.lives = 3
Ship.invuln = 120
Ship.counter = 0
Ship.score = 0

gameOver = 0
wave = 1

// ===== BULLET FUNCTIONS =====

Function bulletInitAll()
    b1_active = 0
    b2_active = 0
    b3_active = 0
    b4_active = 0
    b5_active = 0
End

Function bulletInit(idx)
    If idx = 1 Then b1_active = 0 End
    If idx = 2 Then b2_active = 0 End
    If idx = 3 Then b3_active = 0 End
    If idx = 4 Then b4_active = 0 End
    If idx = 5 Then b5_active = 0 End
End

Function bulletGetSlot()
    If b1_active = 0 Then Return 1 End
    If b2_active = 0 Then Return 2 End
    If b3_active = 0 Then Return 3 End
    If b4_active = 0 Then Return 4 End
    If b5_active = 0 Then Return 5 End
    Return 0
End

Function bulletSpawn(idx, x, y)
    If idx = 1 Then b1_x = x b1_y = y b1_dx = 6 b1_dy = 0 b1_active = 1 b1_life = 48 End
    If idx = 2 Then b2_x = x b2_y = y b2_dx = 6 b2_dy = 0 b2_active = 1 b2_life = 48 End
    If idx = 3 Then b3_x = x b3_y = y b3_dx = 6 b3_dy = 0 b3_active = 1 b3_life = 48 End
    If idx = 4 Then b4_x = x b4_y = y b4_dx = 6 b4_dy = 0 b4_active = 1 b4_life = 48 End
    If idx = 5 Then b5_x = x b5_y = y b5_dx = 6 b5_dy = 0 b5_active = 1 b5_life = 48 End
End

Function bulletUpdate(idx)
    active = 0
    x = 0
    y = 0
    life = 0
    If idx = 1 Then active = b1_active x = b1_x y = b1_y life = b1_life End
    If idx = 2 Then active = b2_active x = b2_x y = b2_y life = b2_life End
    If idx = 3 Then active = b3_active x = b3_x y = b3_y life = b3_life End
    If idx = 4 Then active = b4_active x = b4_x y = b4_y life = b4_life End
    If idx = 5 Then active = b5_active x = b5_x y = b5_y life = b5_life End
    If active = 1 Then
        life = life - 1
        If life <= 0 Then active = 0 End
    End
    If idx = 1 Then b1_active = active b1_life = life End
    If idx = 2 Then b2_active = active b2_life = life End
    If idx = 3 Then b3_active = active b3_life = life End
    If idx = 4 Then b4_active = active b4_life = life End
    If idx = 5 Then b5_active = active b5_life = life End
End

Function bulletGetActive(idx)
    If idx = 1 Then Return b1_active End
    If idx = 2 Then Return b2_active End
    If idx = 3 Then Return b3_active End
    If idx = 4 Then Return b4_active End
    If idx = 5 Then Return b5_active End
    Return 0
End

Function bulletGetX(idx)
    If idx = 1 Then Return b1_x End
    If idx = 2 Then Return b2_x End
    If idx = 3 Then Return b3_x End
    If idx = 4 Then Return b4_x End
    If idx = 5 Then Return b5_x End
    Return 0
End

Function bulletGetY(idx)
    If idx = 1 Then Return b1_y End
    If idx = 2 Then Return b2_y End
    If idx = 3 Then Return b3_y End
    If idx = 4 Then Return b4_y End
    If idx = 5 Then Return b5_y End
    Return 0
End

Function bulletRemove(idx)
    If idx = 1 Then b1_active = 0 End
    If idx = 2 Then b2_active = 0 End
    If idx = 3 Then b3_active = 0 End
    If idx = 4 Then b4_active = 0 End
    If idx = 5 Then b5_active = 0 End
End

// ===== ASTEROID FUNCTIONS =====

Function asteroidInitAll()
    a1_active = 0
    a2_active = 0
    a3_active = 0
    a4_active = 0
    a5_active = 0
    a6_active = 0
    a7_active = 0
    a8_active = 0
    a9_active = 0
    a10_active = 0
    a11_active = 0
    a12_active = 0
End

Function asteroidGetSlot()
    If a1_active = 0 Then Return 1 End
    If a2_active = 0 Then Return 2 End
    If a3_active = 0 Then Return 3 End
    If a4_active = 0 Then Return 4 End
    If a5_active = 0 Then Return 5 End
    If a6_active = 0 Then Return 6 End
    If a7_active = 0 Then Return 7 End
    If a8_active = 0 Then Return 8 End
    If a9_active = 0 Then Return 9 End
    If a10_active = 0 Then Return 10 End
    If a11_active = 0 Then Return 11 End
    If a12_active = 0 Then Return 12 End
    Return 0
End

Function asteroidSpawn(idx, x, y, sz)
    dir = rndr(0, 359)
    If idx = 1 Then a1_x = x a1_y = y a1_size = sz a1_dx = 1 a1_dy = 1 a1_active = 1 End
    If idx = 2 Then a2_x = x a2_y = y a2_size = sz a2_dx = 1 a2_dy = 1 a2_active = 1 End
    If idx = 3 Then a3_x = x a3_y = y a3_size = sz a3_dx = 1 a3_dy = -1 a3_active = 1 End
    If idx = 4 Then a4_x = x a4_y = y a4_size = sz a4_dx = -1 a4_dy = 1 a4_active = 1 End
    If idx = 5 Then a5_x = x a5_y = y a5_size = sz a5_dx = -1 a5_dy = -1 a5_active = 1 End
    If idx = 6 Then a6_x = x a6_y = y a6_size = sz a6_dx = 1 a6_dy = 0 a6_active = 1 End
    If idx = 7 Then a7_x = x a7_y = y a7_size = sz a7_dx = 0 a7_dy = 1 a7_active = 1 End
    If idx = 8 Then a8_x = x a8_y = y a8_size = sz a8_dx = -1 a8_dy = 0 a8_active = 1 End
    If idx = 9 Then a9_x = x a9_y = y a9_size = sz a9_dx = 0 a9_dy = -1 a9_active = 1 End
    If idx = 10 Then a10_x = x a10_y = y a10_size = sz a10_dx = 1 a10_dy = -1 a10_active = 1 End
    If idx = 11 Then a11_x = x a11_y = y a11_size = sz a11_dx = -1 a11_dy = 1 a11_active = 1 End
    If idx = 12 Then a12_x = x a12_y = y a12_size = sz a12_dx = 0 a12_dy = 0 a12_active = 1 End
End

Function asteroidGetActive(idx)
    If idx = 1 Then Return a1_active End
    If idx = 2 Then Return a2_active End
    If idx = 3 Then Return a3_active End
    If idx = 4 Then Return a4_active End
    If idx = 5 Then Return a5_active End
    If idx = 6 Then Return a6_active End
    If idx = 7 Then Return a7_active End
    If idx = 8 Then Return a8_active End
    If idx = 9 Then Return a9_active End
    If idx = 10 Then Return a10_active End
    If idx = 11 Then Return a11_active End
    If idx = 12 Then Return a12_active End
    Return 0
End

Function asteroidGetX(idx)
    If idx = 1 Then Return a1_x End
    If idx = 2 Then Return a2_x End
    If idx = 3 Then Return a3_x End
    If idx = 4 Then Return a4_x End
    If idx = 5 Then Return a5_x End
    If idx = 6 Then Return a6_x End
    If idx = 7 Then Return a7_x End
    If idx = 8 Then Return a8_x End
    If idx = 9 Then Return a9_x End
    If idx = 10 Then Return a10_x End
    If idx = 11 Then Return a11_x End
    If idx = 12 Then Return a12_x End
    Return 0
End

Function asteroidGetY(idx)
    If idx = 1 Then Return a1_y End
    If idx = 2 Then Return a2_y End
    If idx = 3 Then Return a3_y End
    If idx = 4 Then Return a4_y End
    If idx = 5 Then Return a5_y End
    If idx = 6 Then Return a6_y End
    If idx = 7 Then Return a7_y End
    If idx = 8 Then Return a8_y End
    If idx = 9 Then Return a9_y End
    If idx = 10 Then Return a10_y End
    If idx = 11 Then Return a11_y End
    If idx = 12 Then Return a12_y End
    Return 0
End

Function asteroidGetSize(idx)
    If idx = 1 Then Return a1_size End
    If idx = 2 Then Return a2_size End
    If idx = 3 Then Return a3_size End
    If idx = 4 Then Return a4_size End
    If idx = 5 Then Return a5_size End
    If idx = 6 Then Return a6_size End
    If idx = 7 Then Return a7_size End
    If idx = 8 Then Return a8_size End
    If idx = 9 Then Return a9_size End
    If idx = 10 Then Return a10_size End
    If idx = 11 Then Return a11_size End
    If idx = 12 Then Return a12_size End
    Return 0
End

Function asteroidRemove(idx)
    If idx = 1 Then a1_active = 0 End
    If idx = 2 Then a2_active = 0 End
    If idx = 3 Then a3_active = 0 End
    If idx = 4 Then a4_active = 0 End
    If idx = 5 Then a5_active = 0 End
    If idx = 6 Then a6_active = 0 End
    If idx = 7 Then a7_active = 0 End
    If idx = 8 Then a8_active = 0 End
    If idx = 9 Then a9_active = 0 End
    If idx = 10 Then a10_active = 0 End
    If idx = 11 Then a11_active = 0 End
    If idx = 12 Then a12_active = 0 End
End

Function asteroidCount()
    count = a1_active + a2_active + a3_active + a4_active
    count = count + a5_active + a6_active + a7_active + a8_active
    count = count + a9_active + a10_active + a11_active + a12_active
    Return count
End

// ===== ASTEROID UPDATE FUNCTIONS =====

Function asteroidUpdatePos(idx)
    x = 0
    y = 0
    dx = 0
    dy = 0
    active = 0
    sz = 0
    If idx = 1 Then active = a1_active x = a1_x y = a1_y dx = a1_dx dy = a1_dy sz = a1_size End
    If idx = 2 Then active = a2_active x = a2_x y = a2_y dx = a2_dx dy = a2_dy sz = a2_size End
    If idx = 3 Then active = a3_active x = a3_x y = a3_y dx = a3_dx dy = a3_dy sz = a3_size End
    If idx = 4 Then active = a4_active x = a4_x y = a4_y dx = a4_dx dy = a4_dy sz = a4_size End
    If idx = 5 Then active = a5_active x = a5_x y = a5_y dx = a5_dx dy = a5_dy sz = a5_size End
    If idx = 6 Then active = a6_active x = a6_x y = a6_y dx = a6_dx dy = a6_dy sz = a6_size End
    If idx = 7 Then active = a7_active x = a7_x y = a7_y dx = a7_dx dy = a7_dy sz = a7_size End
    If idx = 8 Then active = a8_active x = a8_x y = a8_y dx = a8_dx dy = a8_dy sz = a8_size End
    If idx = 9 Then active = a9_active x = a9_x y = a9_y dx = a9_dx dy = a9_dy sz = a9_size End
    If idx = 10 Then active = a10_active x = a10_x y = a10_y dx = a10_dx dy = a10_dy sz = a10_size End
    If idx = 11 Then active = a11_active x = a11_x y = a11_y dx = a11_dx dy = a11_dy sz = a11_size End
    If idx = 12 Then active = a12_active x = a12_x y = a12_y dx = a12_dx dy = a12_dy sz = a12_size End
    If active = 1 Then
        x = x + dx
        If x < 0 Then x = x + 256 End
        If x > 255 Then x = x - 256 End
        y = y + dy
        If y < 0 Then y = y + 256 End
        If y > 255 Then y = y - 256 End
    End
    If idx = 1 Then a1_x = x a1_y = y End
    If idx = 2 Then a2_x = x a2_y = y End
    If idx = 3 Then a3_x = x a3_y = y End
    If idx = 4 Then a4_x = x a4_y = y End
    If idx = 5 Then a5_x = x a5_y = y End
    If idx = 6 Then a6_x = x a6_y = y End
    If idx = 7 Then a7_x = x a7_y = y End
    If idx = 8 Then a8_x = x a8_y = y End
    If idx = 9 Then a9_x = x a9_y = y End
    If idx = 10 Then a10_x = x a10_y = y End
    If idx = 11 Then a11_x = x a11_y = y End
    If idx = 12 Then a12_x = x a12_y = y End
End

// ===== WAVE MANAGEMENT =====

Function spawnWave(n)
    For i = 1 To n + 2
        slot = asteroidGetSlot()
        If slot > 0 Then
            edge = rndr(0, 3)
            If edge = 0 Then
                asteroidSpawn(slot, rndr(0, 255), 0, rndr(10, 18))
            End
            If edge = 1 Then
                asteroidSpawn(slot, 255, rndr(0, 255), rndr(10, 18))
            End
            If edge = 2 Then
                asteroidSpawn(slot, rndr(0, 255), 255, rndr(10, 18))
            End
            If edge = 3 Then
                asteroidSpawn(slot, 0, rndr(0, 255), rndr(10, 18))
            End
        End
    Next
End

// ===== DRAWING FUNCTIONS =====

Function drawShip(x, y, angle, color)
    noseX = x
    noseY = y - 8
    leftX = x - 5
    leftY = y + 5
    rightX = x + 5
    rightY = y + 5
    SetLayer(5)
    Line(noseX, noseY, leftX, leftY, color)
    Line(leftX, leftY, rightX, rightY, color)
    Line(rightX, rightY, noseX, noseY, color)
End

// ===== GAME LOGIC =====

Function handleInput()
    key = getKey()
    
    // Rotate left
    If key = 97 Then Goto rotLeft End
    If key = 128 Then Goto rotLeft End
    Goto rotDone
rotLeft:
    Ship.angle = Ship.angle - 8
    If Ship.angle < 0 Then Ship.angle = Ship.angle + 360 End
rotDone:
    
    // Rotate right
    If key = 100 Then Goto rotRight End
    If key = 129 Then Goto rotRight End
    Goto rotRightDone
rotRight:
    Ship.angle = Ship.angle + 8
    If Ship.angle > 359 Then Ship.angle = Ship.angle - 360 End
rotRightDone:
    
    // Thrust
    If key = 119 Then Goto doThrust End
    If key = 130 Then Goto doThrust End
    Goto noThrust
doThrust:
    Ship.dx = Ship.dx - 2
    Ship.dy = Ship.dy - 2
    Ship.thrust = 8
noThrust:
    If Ship.thrust > 0 Then
        Ship.thrust = Ship.thrust - 1
    End
    
    // Fire
    If key = 101 Then Goto doFire End
    Goto noFire
doFire:
    slot = bulletGetSlot()
    If slot > 0 Then
        bulletSpawn(slot, Ship.x, Ship.y)
    End
noFire:
End

Function updatePhysics()
    // Apply drag
    Ship.dx = Ship.dx * 3 / 4
    Ship.dy = Ship.dy * 3 / 4
    
    // Update position
    Ship.x = Ship.x + Ship.dx
    Ship.y = Ship.y + Ship.dy
    
    // Wrap
    If Ship.x < 0 Then Ship.x = Ship.x + 256 End
    If Ship.x > 255 Then Ship.x = Ship.x - 256 End
    If Ship.y < 0 Then Ship.y = Ship.y + 256 End
    If Ship.y > 255 Then Ship.y = Ship.y - 256 End
    
    // Invulnerability
    If Ship.invuln > 0 Then
        Ship.invuln = Ship.invuln - 1
    End
End

Function checkAsteroidCollision(ax, ay, asize, px, py, pr)
    dx = px - ax
    dy = py - ay
    dist = dx * dx + dy * dy
    If dist < (pr + asize) * (pr + asize) Then
        Return 1
    End
    Return 0
End

Function checkCollisions()
    // Bullet-Asteroid collisions
    For bi = 1 To MAX_BULLETS
        ba = bulletGetActive(bi)
        If ba = 1 Then
            bx = bulletGetX(bi)
            by = bulletGetY(bi)
            For ai = 1 To MAX_ASTEROIDS
                aa = asteroidGetActive(ai)
                If aa = 1 Then
                    ax = asteroidGetX(ai)
                    ay = asteroidGetY(ai)
                    asize = asteroidGetSize(ai)
                    col = checkAsteroidCollision(ax, ay, asize, bx, by, 2)
                    If col = 1 Then
                        asteroidRemove(ai)
                        bulletRemove(bi)
                        Ship.score = Ship.score + 10
                        PlayTone(880, 100, 192)
                    End
                End
            Next
        End
    Next
    
    // Ship-Asteroid collision
    If Ship.invuln <= 0 Then
        For ai = 1 To MAX_ASTEROIDS
            aa = asteroidGetActive(ai)
            If aa = 1 Then
                ax = asteroidGetX(ai)
                ay = asteroidGetY(ai)
                asize = asteroidGetSize(ai)
                col = checkAsteroidCollision(ax, ay, asize, Ship.x, Ship.y, 4)
                If col = 1 Then
                    Ship.lives = Ship.lives - 1
                    Ship.invuln = 120
                    Ship.dx = -Ship.dx * 2
                    Ship.dy = -Ship.dy * 2
                    PlayTone(220, 300, 255)
                    If Ship.lives <= 0 Then
                        gameOver = 1
                    End
                End
            End
        Next
    End
End

// ===== RENDER =====

Function renderFrame()
    // Clear layers
    SetLayer(4)
    ClrDraw
    SetLayer(5)
    ClrDraw
    
    // Draw asteroids on layer 4
    SetLayer(4)
    For ai = 1 To MAX_ASTEROIDS
        aa = asteroidGetActive(ai)
        If aa = 1 Then
            Circle(asteroidGetX(ai), asteroidGetY(ai), asteroidGetSize(ai), 14)
        End
    Next
    
    // Draw ship and bullets on layer 5
    SetLayer(5)
    If gameOver = 0 Then
        draw = 1
        If Ship.invuln > 0 Then
            If Ship.invuln / 4 * 4 = Ship.invuln Then
                draw = 1
            Else
                draw = 0
            End
        End
        If draw = 1 Then
            drawShip(Ship.x, Ship.y, Ship.angle, 31)
            If Ship.thrust > 0 Then
                PxlOn(Ship.x + 1, Ship.y + 10, 11)
                PxlOn(Ship.x - 1, Ship.y + 10, 11)
            End
        End
    End
    
    // Draw active bullets
    For bi = 1 To MAX_BULLETS
        ba = bulletGetActive(bi)
        If ba = 1 Then
            PxlOn(bulletGetX(bi), bulletGetY(bi), 31)
        End
    Next
    
    // HUD
    SetLayer(0)
    Text(0, 0, "SCORE:", 15)
    Text(48, 0, Ship.score, 15)
    Text(140, 0, "LIVES:", 15)
    Text(188, 0, Ship.lives, 15)
    Text(0, 248, "WAVE:", 10)
    Text(36, 248, wave, 10)
End

Function renderGameOver()
    SetLayer(4)
    ClrDraw
    SetLayer(5)
    ClrDraw
    SetLayer(0)
    Text(80, 120, "GAME OVER", 31)
    Text(64, 136, "Score:", 15)
    Text(112, 136, Ship.score, 15)
    Text(48, 160, "Press R to restart", 10)
End

// ===== INIT =====

Function initGame()
    Ship.x = 128
    Ship.y = 128
    Ship.dx = 0
    Ship.dy = 0
    Ship.angle = 0
    Ship.thrust = 0
    Ship.lives = 3
    Ship.invuln = 120
    Ship.score = 0
    gameOver = 0
    wave = 1
    asteroidInitAll()
    bulletInitAll()
    spawnWave(wave)
End

// ===== MAIN =====

SetLayer(0)
ClrDraw
SetLayer(4)
ClrDraw
SetLayer(5)
ClrDraw

initGame()

// Title
SetLayer(0)
Text(60, 100, "ASTEROIDS", 31)
Text(40, 120, "Press any key", 15)
Pause

// Game loop
While 1
    If gameOver = 0 Then
        handleInput()
        updatePhysics()
        
        For i = 1 To MAX_BULLETS
            bulletUpdate(i)
        Next
        
        For i = 1 To MAX_ASTEROIDS
            asteroidUpdatePos(i)
        Next
        
        checkCollisions()
        
        If asteroidCount() = 0 Then
            wave = wave + 1
            spawnWave(wave)
            Ship.invuln = 60
        End
        
        renderFrame()
    Else
        renderGameOver()
        key = getKey()
        If key = 114 Then
            SetLayer(0)
            ClrDraw
            SetLayer(4)
            ClrDraw
            SetLayer(5)
            ClrDraw
            initGame()
        End
    End
End