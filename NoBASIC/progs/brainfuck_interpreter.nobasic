// Brainfuck interpreter for NoBASIC.
//
// This version stays inside NoBASIC globals instead of MEMWRITE/MEMREAD because
// the current runtime path for general memory writes is unreliable for compiled
// NoBASIC binaries in this repo. The built-in demo program is:
//
//     ++++++++[>++++++++<-]>+.+.
//
// It should produce ASCII "AB" in out0/out1.

GLOBAL programSize, tapeSize, pc, ptr, cmd, cellValue, handled
GLOBAL outCount, inputPos, depth, scan
GLOBAL cell0, cell1, cell2, cell3, cell4, cell5, cell6, cell7
GLOBAL out0, out1, out2, out3, out4, out5, out6, out7
GLOBAL in0, in1, in2, in3

Function initializeState()
    programSize = 26
    tapeSize = 8
    pc = 0
    ptr = 0
    cmd = 0
    cellValue = 0
    handled = 0
    outCount = 0
    inputPos = 0
    depth = 0
    scan = 0

    cell0 = 0
    cell1 = 0
    cell2 = 0
    cell3 = 0
    cell4 = 0
    cell5 = 0
    cell6 = 0
    cell7 = 0

    out0 = 0
    out1 = 0
    out2 = 0
    out3 = 0
    out4 = 0
    out5 = 0
    out6 = 0
    out7 = 0

    in0 = 0
    in1 = 0
    in2 = 0
    in3 = 0
End

Function loadCommand()
    cmd = 0

    If pc = 0 Then
        cmd = 43
    End
    If pc = 1 Then
        cmd = 43
    End
    If pc = 2 Then
        cmd = 43
    End
    If pc = 3 Then
        cmd = 43
    End
    If pc = 4 Then
        cmd = 43
    End
    If pc = 5 Then
        cmd = 43
    End
    If pc = 6 Then
        cmd = 43
    End
    If pc = 7 Then
        cmd = 43
    End
    If pc = 8 Then
        cmd = 91
    End
    If pc = 9 Then
        cmd = 62
    End
    If pc = 10 Then
        cmd = 43
    End
    If pc = 11 Then
        cmd = 43
    End
    If pc = 12 Then
        cmd = 43
    End
    If pc = 13 Then
        cmd = 43
    End
    If pc = 14 Then
        cmd = 43
    End
    If pc = 15 Then
        cmd = 43
    End
    If pc = 16 Then
        cmd = 43
    End
    If pc = 17 Then
        cmd = 43
    End
    If pc = 18 Then
        cmd = 60
    End
    If pc = 19 Then
        cmd = 45
    End
    If pc = 20 Then
        cmd = 93
    End
    If pc = 21 Then
        cmd = 62
    End
    If pc = 22 Then
        cmd = 43
    End
    If pc = 23 Then
        cmd = 46
    End
    If pc = 24 Then
        cmd = 43
    End
    If pc = 25 Then
        cmd = 46
    End
End

Function readCell()
    cellValue = 0

    If ptr = 0 Then
        cellValue = cell0
    End
    If ptr = 1 Then
        cellValue = cell1
    End
    If ptr = 2 Then
        cellValue = cell2
    End
    If ptr = 3 Then
        cellValue = cell3
    End
    If ptr = 4 Then
        cellValue = cell4
    End
    If ptr = 5 Then
        cellValue = cell5
    End
    If ptr = 6 Then
        cellValue = cell6
    End
    If ptr = 7 Then
        cellValue = cell7
    End
End

Function writeCell()
    If ptr = 0 Then
        cell0 = cellValue
    End
    If ptr = 1 Then
        cell1 = cellValue
    End
    If ptr = 2 Then
        cell2 = cellValue
    End
    If ptr = 3 Then
        cell3 = cellValue
    End
    If ptr = 4 Then
        cell4 = cellValue
    End
    If ptr = 5 Then
        cell5 = cellValue
    End
    If ptr = 6 Then
        cell6 = cellValue
    End
    If ptr = 7 Then
        cell7 = cellValue
    End
End

Function emitByte()
    If outCount = 0 Then
        out0 = cellValue
    End
    If outCount = 1 Then
        out1 = cellValue
    End
    If outCount = 2 Then
        out2 = cellValue
    End
    If outCount = 3 Then
        out3 = cellValue
    End
    If outCount = 4 Then
        out4 = cellValue
    End
    If outCount = 5 Then
        out5 = cellValue
    End
    If outCount = 6 Then
        out6 = cellValue
    End
    If outCount = 7 Then
        out7 = cellValue
    End

    If outCount < 8 Then
        outCount = outCount + 1
    End
End

Function readInputValue()
    cellValue = 0

    If inputPos = 0 Then
        cellValue = in0
    End
    If inputPos = 1 Then
        cellValue = in1
    End
    If inputPos = 2 Then
        cellValue = in2
    End
    If inputPos = 3 Then
        cellValue = in3
    End

    If cellValue <> 0 Then
        inputPos = inputPos + 1
    End
End

Function skipForward()
    depth = 1
    scan = pc + 1

    While depth > 0
        pc = scan
        loadCommand()
        If cmd = 91 Then
            depth = depth + 1
        End
        If cmd = 93 Then
            depth = depth - 1
        End
        scan = scan + 1
    End

    pc = scan
End

Function skipBackward()
    depth = 1
    scan = pc - 1

    While depth > 0
        pc = scan
        loadCommand()
        If cmd = 93 Then
            depth = depth + 1
        End
        If cmd = 91 Then
            depth = depth - 1
        End
        If depth > 0 Then
            scan = scan - 1
        End
    End

    pc = scan + 1
End

Function runInterpreter()
    pc = 0
    ptr = 0
    outCount = 0
    inputPos = 0

    While pc < programSize
        loadCommand()
        handled = 0

        If cmd = 62 Then
            ptr = ptr + 1
            If ptr >= tapeSize Then
                ptr = 0
            End
            pc = pc + 1
            handled = 1
        End

        If cmd = 60 Then
            If ptr = 0 Then
                ptr = tapeSize - 1
            Else
                ptr = ptr - 1
            End
            pc = pc + 1
            handled = 1
        End

        If cmd = 43 Then
            readCell()
            If cellValue = 255 Then
                cellValue = 0
            Else
                cellValue = cellValue + 1
            End
            writeCell()
            pc = pc + 1
            handled = 1
        End

        If cmd = 45 Then
            readCell()
            If cellValue = 0 Then
                cellValue = 255
            Else
                cellValue = cellValue - 1
            End
            writeCell()
            pc = pc + 1
            handled = 1
        End

        If cmd = 46 Then
            readCell()
            emitByte()
            pc = pc + 1
            handled = 1
        End

        If cmd = 44 Then
            readInputValue()
            writeCell()
            pc = pc + 1
            handled = 1
        End

        If cmd = 91 Then
            readCell()
            If cellValue = 0 Then
                skipForward()
            Else
                pc = pc + 1
            End
            handled = 1
        End

        If cmd = 93 Then
            readCell()
            If cellValue <> 0 Then
                skipBackward()
            Else
                pc = pc + 1
            End
            handled = 1
        End

        If handled = 0 Then
            pc = pc + 1
        End
    End
End

initializeState()
runInterpreter()