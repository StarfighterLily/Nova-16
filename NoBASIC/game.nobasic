// Define game structs
STRUCT Player x y oldx oldy facing counter END
Struct Enemy ex ey eoldx eoldy ecounter End

// Initialize Player struct
player.x = 8
player.y = 8
player.oldx = 8
player.oldy = 8
player.facing = 0
player.counter = 0

// Initialize enemy variables
enemy.ex = 128
enemy.ey = 128
enemy.eoldx = 128
enemy.eoldy = 128
enemy.ecounter = 0

// Initialize other variables
Str1 = "--"    // Sword sprite

// Initialize level
SetLayer(1)
For a = 0 to 248 Step 4
    Text(0, a, "X                              X", 0x1F)
Next
ScrRotate(0, 1)
For a = 0 to 248 Step 4
    Text(0, a, "X                              X", 0x1F)
Next

// Function definitions
Function renderPlayer(x, y, color)
    Text(x, y, "O", color)
    Text(x, y + 8, "X", color)
End

Function renderEnemy(x, y, color)
    Text(x, y, "m", color)
End

Function drawPlayer()
    If player.oldx <> player.x Then
        renderPlayer(player.oldx, player.oldy, 0x00)
    End
    If player.oldy <> player.y Then
        renderPlayer(player.oldx, player.oldy, 0x00)
    End
    renderPlayer(player.x, player.y, 0x0F)
End

Function drawEnemy()
    If enemy.eoldx <> enemy.ex Then
        renderEnemy(enemy.eoldx, enemy.eoldy, 0x00)
    End
    If enemy.eoldy <> enemy.ey Then
        renderEnemy(enemy.eoldx, enemy.eoldy, 0x00)
    End
    renderEnemy(enemy.ex, enemy.ey, 0x0C)
End

Function clearSword()
    player.counter = 0
    Text(player.oldx - 16, player.oldy + 8, Str1, 0x00)
    Text(player.oldx + 8, player.oldy + 8, Str1, 0x00)
End

Function attack()
    If player.facing = 0 Then
        Text(player.x - 16, player.y + 8, Str1, 0x0F)
    End
    If player.facing = 1 Then
       Text(player.x + 8, player.y + 8, Str1, 0x0F)
    End
    player.counter = 0
End

Function keyCheck()
    key = getKey()
        If key = 101 Then // 'e'
            attack()
        End

        If key = 97 Then // 'a'
            player.x = player.x - 8
            player.facing = 0
        End
        If key = 128 Then // left
            player.x = player.x - 8
            player.facing = 0
        End

        If key = 100 Then // 'd'
            player.x = player.x + 8
            player.facing = 1
        End
        If key = 129 Then // right
            player.x = player.x + 8
            player.facing = 1
        End

        If key = 115 Then // 's'
            player.y = player.y + 8
        End
        If key = 131 Then // down
            player.y = player.y + 8
        End

        If key = 119 Then // 'w'
            player.y = player.y - 8
        End
        If key = 130 Then // up
            player.y = player.y - 8
        End
End

Function callPlayer()
    player.oldx = player.x
    player.oldy = player.y
    player.counter++

    keyCheck()

    If player.x < 8 Then
        player.x = 8
    End
    If player.x > 240 Then
        player.x = 240
    End
    If player.y < 8 Then
        player.y = 8
    End
    If player.y > 232 Then
        player.y = 232
    End

    drawPlayer()

    If player.counter = 8 or player.x <> player.oldx or player.y <> player.oldy Then
        clearSword()
    End
End

Function callEnemy()
    enemy.ecounter++

    enemy.eoldx = enemy.ex
    enemy.eoldy = enemy.ey
    direction = rndr(0, 3)
    If enemy.ecounter = 64 Then
        If direction = 0 Then
            enemy.ex = enemy.ex - 8
        End
        If direction = 1 Then
            enemy.ex = enemy.ex + 8
        End
        If direction = 2 Then
            enemy.ey = enemy.ey - 8
        End
        If direction = 3 Then
            enemy.ey = enemy.ey + 8
        End

        If enemy.ex < 8 Then
            enemy.ex = 8
        End
        If enemy.ex > 240 Then
            enemy.ex = 240
        End
        If enemy.ey < 8 Then
            enemy.ey = 8
        End
        If enemy.ey > 232 Then
            enemy.ey = 232
        End
        enemy.ecounter = 0
    End

    drawEnemy()
End

// Main loop
SetLayer(5)
While 1
    callEnemy()
    callPlayer()
End