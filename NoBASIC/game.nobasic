// Define game structs
STRUCT Player x y oldx oldy facing counter END

// Initialize Player struct
Player.x = 8
Player.y = 8
Player.oldx = 8
Player.oldy = 8
Player.facing = 0
Player.counter = 0

// Initialize other variables
Str1 = "--"    // Sword sprite

// Initialize level
SetLayer(1)
For a = 0 to 248 Step 4
    Text(0, a, "X                              X", 0x1F)
Next
ScrRotate(0, 1)
For a = 0 to 248 Step 4
    Text(0, a, "X                              X", 0x1F)
Next

// Function definitions
Function renderPlayer(x, y, color)
    Text(x, y, "O", color)
    Text(x, y + 8, "X", color)
End

Function drawPlayer()
    If Player.oldx <> Player.x Then
        renderPlayer(Player.oldx, Player.oldy, 0x00)
    End
    If Player.oldy <> Player.y Then
        renderPlayer(Player.oldx, Player.oldy, 0x00)
    End
    renderPlayer(Player.x, Player.y, 0x0F)
End

Function attack()
    If Player.facing = 0 Then
        Text(Player.x - 16, Player.y + 8, Str1, 0x0F)
    End
    If Player.facing = 1 Then
       Text(Player.x + 8, Player.y + 8, Str1, 0x0F)
    End
    Player.counter = 0
End

Function keyCheck()
    key = getKey()
        If key = 101 Then // 'e'
            attack()
        End

        If key = 97 Then // 'a'
            Player.x = Player.x - 8
            Player.facing = 0
        End
        If key = 128 Then // right
            Player.x = Player.x - 8
            Player.facing = 0
        End

        If key = 100 Then // 'd'
            Player.x = Player.x + 8
            Player.facing = 1
        End
        If key = 129 Then // left
            Player.x = Player.x + 8
            Player.facing = 1
        End

        If key = 115 Then // 's'
            Player.y = Player.y + 8
        End
        If key = 131 Then // down
            Player.y = Player.y + 8
        End

        If key = 119 Then // 'w'
            Player.y = Player.y - 8
        End
        If key = 130 Then // up
            Player.y = Player.y - 8
        End
End

Function callPlayer()
    Player.oldx = Player.x
    Player.oldy = Player.y
    Player.counter++

    keyCheck()

    If Player.x < 8 Then
        Player.x = 8
    End
    If Player.x > 240 Then
        Player.x = 240
    End
    If Player.y < 8 Then
        Player.y = 8
    End
    If Player.y > 232 Then
        Player.y = 232
    End

    drawPlayer()

    If Player.counter = 255 Then
        Player.counter = 0
        Text(Player.oldx - 16, Player.oldy + 8, Str1, 0x00)
        Text(Player.oldx + 8, Player.oldy + 8, Str1, 0x00)
    End
End

// Main loop
SetLayer(5)
While 1
    callPlayer()
End