// Define game structs
STRUCT Player x y oldx oldy facing counter END

// Initialize game
SetLayer(1)
Text(0, 0, "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", 0x1F)
For a = 0 to 240 Step 8
    Text(0, a, "X                              X", 0x1F)
Next
Text(0, 248, "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", 0x1F)

Str1 = "--"

// Initialize player struct
player.x = 8
player.y = 8
player.oldx = 8
player.oldy = 8
player.facing = 0
player.counter = 0

SetLayer(5)
While 1

    Player:
       // Store old position
       player.oldx = player.x
       player.oldy = player.y
       player.counter = player.counter + 1

       key = getKey()
       
       // Handle attack action
       If key = 101 Then // 'e'
           If player.facing = 0 Then
               Text(player.x - 16, player.y + 8, Str1, 0x0F)
           End
           If player.facing = 1 Then
               Text(player.x + 8, player.y + 8, Str1, 0x0F)
           End
           player.counter = 0
       End
       
       // Handle movement - left
       If key = 97 Then // 'a'
           player.x = player.x - 8
           player.facing = 0
       End
       If key = 128 Then // right arrow
           player.x = player.x - 8
           player.facing = 0
       End

       // Handle movement - right
       If key = 100 Then // 'd'
           player.x = player.x + 8
           player.facing = 1
       End
       If key = 129 Then // left arrow
           player.x = player.x + 8
           player.facing = 1
       End
       
       // Handle movement - down
       If key = 115 Then // 's'
           player.y = player.y + 8
       End
       If key = 131 Then // down arrow
           player.y = player.y + 8
       End
       
       // Handle movement - up
       If key = 119 Then // 'w'
           player.y = player.y - 8
       End
       If key = 130 Then // up arrow
           player.y = player.y - 8
       End

       // Boundary checking
       If player.x < 8 Then
           player.x = 8
       End
       If player.x > 240 Then
           player.x = 240
       End
       If player.y < 8 Then
           player.y = 8
       End
       If player.y > 232 Then
           player.y = 232
       End

       // Clear old player position if moved
       If player.oldx <> player.x Then
           Text(player.oldx, player.oldy, "O", 0x00)
           Text(player.oldx, player.oldy + 8, "X", 0x00)
           Text(player.oldx - 16, player.oldy + 8, Str1, 0x00)
           Text(player.oldx + 8, player.oldy + 8, Str1, 0x00)
       End
       If player.oldy <> player.y Then
           Text(player.oldx, player.oldy, "O", 0x00)
           Text(player.oldx, player.oldy + 8, "X", 0x00)
           Text(player.oldx - 16, player.oldy + 8, Str1, 0x00)
           Text(player.oldx + 8, player.oldy + 8, Str1, 0x00)
       End

       // Draw player at new position
       Text(player.x, player.y, "O", 0x0F)
       Text(player.x, player.y + 8, "X", 0x0F)

       // Clear attack animation after timeout
       If player.counter = 255 Then
           player.counter = 0
           Text(player.oldx - 16, player.oldy + 8, Str1, 0x00)
           Text(player.oldx + 8, player.oldy + 8, Str1, 0x00)
       End

End