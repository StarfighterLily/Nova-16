// Comprehensive Register Allocation Test
// Tests complex expressions, nested calls, and graphics operations

SetLayer(1)

// Test complex arithmetic expressions
a = 10
b = 20
c = 30
d = 40

// Complex expression with multiple operations
result1 = (a + b) * (c - d) / 2 + (a * b + c * d)

// Nested function calls and complex expressions
x = 5
y = 8
z = 12

// Graphics with complex coordinate calculations
For i = 0 To 5
    For j = 0 To 5
        // Complex coordinate calculations
        px = i * 10 + (j * 2) + (i + j) * 3
        py = j * 8 + (i * 3) + (px / 4)
        color = (i * j * 16) + (px + py) / 2 + 100
        
        PxlOn(px, py, color)
    Next
Next

// Test function calls with complex arguments
For k = 0 To 3
    val1 = k * 15 + 50
    val2 = k * 20 + 30
    val3 = (val1 + val2) * 2
    
    // More complex expressions
    final_color = (val1 * val2 + val3) / (k + 1) + 128
    PxlOn(k * 50 + 100, k * 40 + 50, final_color)
Next

Pause