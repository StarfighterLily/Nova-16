// Test various For loop patterns to validate optimization

// Test 1: Simple ascending loop
For i = 0 To 10
    PxlOn(i, i, i)
Next

// Test 2: Loop with step
For j = 0 To 100 Step 5
    PxlOn(j, 50, 15)
Next

// Test 3: Nested loops (like screen_fill)
For y = 0 To 15
    For x = 0 To 15
        PxlOn(x, y, 7)
    Next
Next

// Test 4: Loop with expression as end value
a = 20
For k = 0 To a + 10
    PxlOn(k, 100, k)
Next

// Test 5: Triple nested loop
For z = 0 To 3
    For y = 0 To 3
        For x = 0 To 3
            PxlOn(x, y, z)
        Next
    Next
Next

Pause
