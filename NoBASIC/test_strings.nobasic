// NoBASIC String Test Program
// Tests string literals, variables, assignment, and concatenation

// Test 1: Simple string literal display
Text(0, 0, "Hello World!", 15)

// Test 2: String variable assignment
Str1 = "Nova"
Text(0, 10, Str1, 31)

// Test 3: String variable copying
Str2 = Str1
Text(0, 20, Str2, 14)

// Test 4: String concatenation
Str3 = "Hello " + "World"
Text(0, 30, Str3, 10)

// Test 5: Mixed concatenation
Str4 = Str1 + " is awesome!"
Text(0, 40, Str4, 12)

// Test 6: Disp with string
Disp "Test Complete"

Pause
