// Moving sprite with struct - DEBUG version
// Let's see what's actually happening

STRUCT Sprite
    x
    y
    vx
    vy
    color
    active
END

SetLayer(1)
ClrDraw

// Initialize sprite
Sprite.x = 50
Sprite.y = 50
Sprite.vx = 2
Sprite.vy = 2
Sprite.color = 31
Sprite.active = 1

// Draw a trail - don't clear old pixels
For frame = 0 To 100
    // Update position
    Sprite.x = Sprite.x + Sprite.vx
    Sprite.y = Sprite.y + Sprite.vy
    
    // Boundary checking - bounce off walls
    If Sprite.x > 250 Then
        Sprite.vx = -2
    End
    
    If Sprite.x < 5 Then
        Sprite.vx = 2
    End
    
    If Sprite.y > 250 Then
        Sprite.vy = -2
    End
    
    If Sprite.y < 5 Then
        Sprite.vy = 2
    End
    
    // Draw at new position (leaving a trail)
    PxlOn(Sprite.x, Sprite.y, Sprite.color)
    
    // Delay loop
    For delay = 0 To 10000
        x = delay
    Next
Next

Disp "Done! Check the trail!"
Pause
