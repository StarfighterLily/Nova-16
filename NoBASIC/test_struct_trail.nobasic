// Bouncing sprite test - Drawing on LAYER 0 (main layer)
// Simple visible trail to prove structs work

STRUCT Ball
    x
    y
    vx
    vy
END

// Draw on MAIN LAYER (layer 0, not layer 1!)
SetLayer(0)
ClrDraw

// Initialize ball
Ball.x = 50
Ball.y = 50
Ball.vx = 3
Ball.vy = 2

// Draw just 20 positions to create a visible trail
For frame = 0 To 20
    // Draw ball position (bright red, 2x2 pixels)
    PxlOn(Ball.x, Ball.y, 31)
    PxlOn(Ball.x + 1, Ball.y, 31)
    PxlOn(Ball.x, Ball.y + 1, 31)
    PxlOn(Ball.x + 1, Ball.y + 1, 31)
    
    // Update position (structs in action!)
    Ball.x = Ball.x + Ball.vx
    Ball.y = Ball.y + Ball.vy
    
    // Simple boundary check
    If Ball.x > 240 Then
        Ball.vx = 0 - Ball.vx
    End
    
    If Ball.y > 240 Then
        Ball.vy = 0 - Ball.vy
    End
    Pause
Next

// Draw final message on top
Text(10, 10, "Struct trail!", 15)
