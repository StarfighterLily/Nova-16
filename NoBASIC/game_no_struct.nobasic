// Original game without structs for comparison
SetLayer(1)
Text(0, 0, "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", 0x1F)
For a = 0 to 240 Step 8
    Text(0, a, "X                              X", 0x1F)
Next
Text(0, 248, "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", 0x1F)

Str1 = "--"

x = 8
y = 8
facing = 0
counter = 0

SetLayer(5)
While 1

    Player:
       oldx = x
       oldy = y
       counter = counter + 1

       key = getKey()
       
       If key = 101 Then // 'e'
           If facing = 0 Then
               Text(x - 16, y + 8, Str1, 0x0F)
           End
           If facing = 1 Then
               Text(x + 8, y + 8, Str1, 0x0F)
           End
           counter = 0
       End
       
       If key = 97 Then // 'a'
           x = x - 8
           facing = 0
       End
       If key = 128 Then // right
           x = x - 8
           facing = 0
       End

       If key = 100 Then // 'd'
           x = x + 8
           facing = 1
       End
       If key = 129 Then // left
           x = x + 8
           facing = 1
       End
       
       If key = 515 Then // 's'
           y = y + 8
       End
       If key = 131 Then // down
           y = y + 8
       End
       
       If key = 119 Then // 'w'
           y = y - 8
       End
       If key = 130 Then // up
           y = y - 8
       End

       If x < 8 Then
           x = 8
       End
       If x > 240 Then
           x = 240
       End
       If y < 8 Then
           y = 8
       End
       If y > 232 Then
           y = 232
       End

       If oldx <> x Then
           Text(oldx, oldy, "O", 0x00)
           Text(oldx, oldy + 8, "X", 0x00)
           Text(oldx - 16, oldy + 8, Str1, 0x00)
           Text(oldx + 8, oldy + 8, Str1, 0x00)
       End
       If oldy <> y Then
           Text(oldx, oldy, "O", 0x00)
           Text(oldx, oldy + 8, "X", 0x00)
           Text(oldx - 16, oldy + 8, Str1, 0x00)
           Text(oldx + 8, oldy + 8, Str1, 0x00)
       End

       Text(x, y, "O", 0x0F)
       Text(x, y + 8, "X", 0x0F)

       If counter = 255 Then
           counter = 0
           Text(oldx - 16, oldy + 8, Str1, 0x00)
           Text(oldx + 8, oldy + 8, Str1, 0x00)
       End

End
