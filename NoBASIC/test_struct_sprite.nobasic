// Moving sprite with struct
// Bouncing ball demo using structs

STRUCT Sprite
    x
    y
    vx
    vy
    color
    active
END

SetLayer(1)
ClrDraw

// Initialize sprite
Sprite.x = 128
Sprite.y = 128
Sprite.vx = 2
Sprite.vy = -1
Sprite.color = 15
Sprite.active = 1

// Game loop - 100 iterations
For i = 0 To 100
    // Clear previous position (simple approach)
    PxlOff(Sprite.x, Sprite.y)
    
    // Update position
    Sprite.x = Sprite.x + Sprite.vx
    Sprite.y = Sprite.y + Sprite.vy
    
    // Boundary checking - bounce off walls
    If Sprite.x > 250 Then
        Sprite.vx = -2
    End
    
    If Sprite.x < 5 Then
        Sprite.vx = 2
    End
    
    If Sprite.y > 250 Then
        Sprite.vy = -1
    End
    
    If Sprite.y < 5 Then
        Sprite.vy = 1
    End
    
    // Draw at new position
    PxlOn(Sprite.x, Sprite.y, Sprite.color)
Next

Disp "Done!"
Pause
