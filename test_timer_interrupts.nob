REM Test timer and interrupt features for Nova-16
CLRHOME
DISP "Timer/Interrupt Test"

REM Declare variables
TIMER_VALUE = 1000
TIMER_MATCH = 2000
TIMER_CONTROL = 1
TIMER_SPEED = 10
VEC = 0
VECTOR_ADDR = 0

REM Test timer registers (TT, TM, TC, TS)
DISP "Testing timer functionality"

REM Note: Direct register access would be needed
REM TT = TIMER_VALUE
REM TM = TIMER_MATCH
REM TC = TIMER_CONTROL
REM TS = TIMER_SPEED

DISP "Timer configured with:"
DISP "Value:", TIMER_VALUE
DISP "Match:", TIMER_MATCH
DISP "Control:", TIMER_CONTROL
DISP "Speed:", TIMER_SPEED

REM Test interrupt vectors (8 vectors at 0x0100-0x011F)
DISP "Interrupt vectors available:"
FOR VEC = 0 TO 7
  VECTOR_ADDR = 256 + (VEC * 4)  REM 0x0100 = 256
  DISP "Vector", VEC, "at address", VECTOR_ADDR
END

REM Simulate interrupt handling
DISP "Interrupt simulation complete"

DISP "Timer/interrupt test complete!"
PAUSE
END