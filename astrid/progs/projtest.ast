//=============================================================================
// projtest.ast -- headless validation of the camera.ast projection math.
//
// Pokes result words into scratch RAM at 0x9000..0x9032 and draws two line
// segments. The Python model in tests/astrid/test_astrid_camera_3d.py
// rebuilds every value from the same integer rules and compares, and it also
// checks the framebuffer against a Bresenham replay of the predicted screen
// endpoints. Hand-derived anchors documented by the test:
//   * a point straight ahead lands exactly on the screen center (128, 128)
//   * a point behind the camera is rejected by cam_project
//   * a fully visible segment draws on layer 0 with no stray pixels
//
// Scratch slots (word each, address = 0x9000 + slot * 2):
//   0-2   transform of (0,0,100) with the camera at the origin, yaw 0
//   3-5   cam_project of that point: ok, px, py
//   6-8   point 50 right / 100 ahead: ok, px, py
//   9     point 50 behind: rejected (0)
//   10-12 yaw 402 (~90 deg): world +x point becomes straight ahead
//   13-15 camera at (30,0,20): point at (30,0,120) is 100 straight ahead
//   16-21 cam_forward(48) while facing +x: xq, yq, zq, sin, cos, yaw
//   22-24 transform of the behind point (kept for the model check)
//   25-26 cam_depth straight ahead / behind
//   27-30 screen endpoints of the visible diagonal (px1, py1, px2, py2)
//   31-32 markers proving both cam_line calls ran
//   33    cam_depth at 200 (still positive this far out)
//=============================================================================
include "includes/camera.ast";

// Store a result word at fixed scratch (slot 0 -> 0x9000, 1 -> 0x9002, ...).
void put(int slot, int value) {
    poke2(0x9000 + slot * 2, value);
}

void main() {
    struct CamPt v;

    // Case 1: camera at the origin, yaw 0 (facing +z); point 100 ahead.
    cam_set(0, 0, 0, 0);
    v = cam_transform(0, 0, 100);
    put(0, v.x);
    put(1, v.y);
    put(2, v.z);
    put(3, cam_project(v));
    put(4, cam_px);
    put(5, cam_py);

    // Case 2: point 50 right, 100 ahead -> projects right of center.
    v = cam_transform(50, 0, 100);
    put(6, cam_project(v));
    put(7, cam_px);
    put(8, cam_py);

    // Case 3: point behind the camera -> rejected (0).
    v = cam_transform(0, 0, -50);
    put(22, v.x);
    put(23, v.y);
    put(24, v.z);
    put(9, cam_project(v));

    // Case 4: yaw = 402 (~90 deg); world +x point becomes straight ahead.
    cam_set(0, 0, 0, 402);
    v = cam_transform(100, 0, 0);
    put(10, cam_project(v));
    put(11, cam_px);
    put(12, cam_py);

    // Case 5: camera at (30,0,20) facing +z; a point 100 ahead of it.
    cam_set(30, 0, 20, 0);
    v = cam_transform(30, 0, 120);
    put(13, cam_project(v));
    put(14, cam_px);
    put(15, cam_py);

    // Case 6: forward movement while facing +x moves the camera by
    // (sin, cos) * 6 world units, held in 1/8-world units.
    cam_set(0, 0, 0, 402);
    cam_forward(48);
    put(16, cam_xq);
    put(17, cam_yq);
    put(18, cam_zq);
    put(19, cam_sin);
    put(20, cam_cos);
    put(21, cam_yaw);

    // Case 7: view depth in world units; 0 means "at or behind the near
    // plane", which is also the visibility test cam_line uses.
    cam_set(0, 0, 0, 0);
    put(25, cam_depth(0, 0, 100));   // 100 ahead -> 100
    put(26, cam_depth(0, 0, -50));   // 50 behind the eye -> 0

    // Case 8: screen endpoints of a fully visible diagonal, then two cam_line
    // calls. The test replays the same endpoints and the Bresenham rasterizer
    // against the framebuffer, including the near-plane clip of a segment
    // whose first endpoint sits closer than CAM_NEAR.
    cam_set(0, 0, 0, 0);
    struct CamPt p1 = cam_transform(-50, -50, 100);
    struct CamPt p2 = cam_transform(50, 50, 100);
    cam_project(p1);
    put(27, cam_px);
    put(28, cam_py);
    cam_project(p2);
    put(29, cam_px);
    put(30, cam_py);
    cam_line(-50, -50, 100, 50, 50, 100, 0x1F);
    put(31, 1);                      // marker: the visible diagonal was drawn
    cam_line(0, 0, 10, 80, 0, 200, 0x1F);    // z = 10 < CAM_NEAR: clipped
    put(32, 1);                      // marker: the clipped segment was drawn
    put(33, cam_depth(0, 0, 200));   // 200 straight ahead -> 200

    halt();
}
