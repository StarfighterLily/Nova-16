include "includes\debug.ast";

struct World {
    int gravity;
    int friction;
    int groundh;
} World = {1, 1, 248};

struct Player {
    int x;
    int y;
    int vx;
    int vy;
    int runspeed;
    int maxspeed;
    int jumpspeed;
    int isGrounded;
} Player = {128, 128, 0, 0, 3, 5, 8, 0};

void memsprite(int addr, int sprite[128]) {
    set_bank(1);
    for (int x = 0; x < 128; x++) {
        poke(addr + x, sprite[x]);
    }
    set_bank(0);
}

void SCBwrite(int id, int addrhi, int addrlo, int x, int y, int w, int h, int flags, int transparency) {
    int base;
    base = 0xF000 + (id * 16);
    poke(base+0, addrhi);
    poke(base+1, addrlo);
    poke(base+2, x);
    poke(base+3, y);
    poke(base+4, w);
    poke(base+5, h);
    poke(base+6, flags);
    poke(base+7, transparency);
}

impl Player {
    void blitPlayer(self) {
        set_bank(1);
        int last = get_layer();
        set_layer(5);
        screen_fill(0x00);
        sprite_blit(0);
        set_layer(last);
        set_bank(0);
    }

    void updatePhysics(self) {
        self.vy += World.gravity;
        self.x += self.vx;
        self.y += self.vy;

        int floor_y = World.groundh - 16;
        if (self.y >= floor_y) {
            self.y = floor_y;
            self.vy = 0;
            self.isGrounded = 1;
        } else {
            self.isGrounded = 0;
        }

        SCBwrite(0, 0x80, 0x00, self.x, self.y, 8, 16, 0b00000011, 0x00);
    }

    void jump(self) {
        if (self.isGrounded == 1) {
            self.vy = -self.jumpspeed;
            self.isGrounded = 0;
        }
    }
}

void loadPlayer() {
    int player[128] = {
        00,00,05,05,05,05,05,05,
        00,05,05,05,05,05,05,05,
        05,05,05,05,02,15,02,15,
        05,05,05,15,02,15,02,15,
        05,05,05,15,15,15,15,15,
        05,05,05,15,15,15,15,00,
        05,05,05,95,95,95,95,00,
        05,05,05,95,95,95,95,95,
        05,05,05,95,95,95,95,95,
        05,05,95,15,95,95,95,00,
        05,05,95,15,95,95,95,00,
        00,95,95,15,95,95,95,00,
        00,95,95,95,95,95,95,00,
        95,95,95,95,95,95,95,95,
        02,02,02,02,02,02,02,02,
        02,02,02,02,02,02,02,02
    };
    memsprite(0x8000, player);
    SCBwrite(0, 0x80, 0x00, 128, 128, 8, 16, 0b00000011, 0x00);
}

void processInput() {
    int key = key_read();
    int moving = 0;

    // 'a' key: Accelerate Left
    if (key == 97) {
        Player.vx -= Player.runspeed;
        if (Player.vx < -Player.maxspeed) {
            Player.vx = -Player.maxspeed;
        }
        moving = 1;
    }
    
    // 'd' key: Accelerate Right
    if (key == 100) {
        Player.vx += Player.runspeed;
        if (Player.vx > Player.maxspeed) {
            Player.vx = Player.maxspeed;
        }
        moving = 1;
    }

    // 'w' key: Jump
    if (key == 119) {
        Player.jump();
    }

    if (moving == 0) {
        if (Player.vx > 0) {
            Player.vx -= World.friction;
        } else if (Player.vx < 0) {
            Player.vx += World.friction;
        }
    }
}

void wallSecUpdate() {
}

void midSpdUpdate() {
    processInput();
    Player.blitPlayer();
    Player.updatePhysics();
}

void main() {
    int counter = 0;
    unsigned int rtc = get_rtc(1);
    unsigned int last = rtc;
    loadPlayer();
    while (1) {
        counter++;
        if ((counter % 6400) == 0) {
            rtc = get_rtc(1);
            if (rtc - last >= 1) {
                last = rtc;
                wallSecUpdate();
            }
            midSpdUpdate();
            counter = 0;
        }
    }
}