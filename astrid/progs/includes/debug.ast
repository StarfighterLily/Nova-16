struct dbg {
    int x;
    int y;
} dbg = {0,0};

impl dbg {
    void print(self, string text) {
        int origlayer = get_layer();
        set_layer(8);
        set_pos(self.x, self.y);
        write_text(text, 0x1F);
        set_layer(origlayer);
        self.y += 8;
        if (self.y >= 248) {
            self.y = 0;
            self.x += 32;
        }
        if (self.x >= 248) {
            set_layer(8);
            screen_fill(0x00);
            set_layer(origlayer);
        }
    }

    void peer(self, unsigned int addr, unsigned int length) {
        for (unsigned int x = addr; x < (addr+length); x++) {
            self.print((string)peek(x));
        }
    }
}