struct dbg {
    int x;
    int y;
    int longest;
} dbg = {0,0,0};

impl dbg {
    void print(self, string text) {
        int origlayer = get_layer();
        int curlen = strlen(text);
        if (curlen > self.longest) {
            self.longest = curlen;
        }
        set_layer(8);
        set_pos(self.x, self.y);
        write_text(text, 0x1F);
        set_layer(origlayer);
        self.y += 8;
        if (self.y >= 248) {
            self.y = 0;
            self.x += (self.longest * 8) + 4;
        }
        if (self.x >= 248) {
            set_layer(8);
            screen_fill(0x00);
            set_layer(origlayer);
        }
    }

    void peer(self, unsigned int addr, unsigned int length) {
        for (unsigned int x = addr; x < (addr+length); x++) {
            self.print((stringh)peek(x));
        }
    }

    void scope(self, void var) {
        self.peer(&var, sizeof(var));
    }

    void dump(self, unsigned int addr) {
        self.peer(addr, 216);
    }
}