include "includes\debug.ast"

void main() {
    unsigned int rtc = get_rtc(1);
    for (unsigned int x = 0; x < 65535; x++) {
        for (unsigned int y = 0; y < 2; y++) {
            nop();
        }
    }
    unsigned int rtc1 = get_rtc(1);
    if (rtc != rtc1) {
        dbg.print("no match");
    } else {
        dbg.print("match");
    }
    dbg.print((string)rtc);
    dbg.print((string)rtc1);
}