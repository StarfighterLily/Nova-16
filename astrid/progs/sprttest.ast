struct Missile {
    int pmissile1;
    int mx1;
    int my1;
    int pmissile2;
    int mx2;
    int my2;
    int pmissile3;
    int mx3;
    int my3;
} Missile = {0, 0, 0, 0, 0, 0, 0, 0, 0};

struct Player {
    int x;
    int y;
    int hit;
} Player = {0, 0, 0};

impl Player {
    void movePlayer(self, int direction) {
        switch (direction) {
            case 0:
                self.y -= 4;
                break;
            case 1:
                self.y += 4;
                break;
            case 2:
                self.x -= 4;
                break;
            case 3:
                self.x += 4;
                break;
        }
        if (self.x > 248) {
            self.x = 248;
        }
        if (self.y > 248) {
            self.y = 248;
        }
        if (self.x <= 4) {
            self.x = 4;
        }
        if (self.y <= 4) {
            self.y = 4;
        }
        // Update the SCB so the sprite is rendered at the new position
        SCBwrite(0, 0x80, 0x00, self.x, self.y, 8, 8, 0b00000011, 0x00);
        //key_clear();
    }
}

impl Missile {
    void fireMissile(self) {
        if (self.pmissile1 == 0) {
            self.mx1 = peek(0xf000 + 2);
            self.my1 = peek(0xf000 + 3);
            self.pmissile1 = 1;
            SCBwrite(1, 0x80, 0x40, self.mx1, self.my1, 8, 8, 0b00000011, 0x00);
        } else if (self.pmissile2 == 0) {
            self.mx2 = peek(0xf000 + 2);
            self.my2 = peek(0xf000 + 3);
            self.pmissile2 = 1;
            SCBwrite(2, 0x80, 0x40, self.mx2, self.my2, 8, 8, 0b00000011, 0x00);
        } else if (self.pmissile3 == 0) {
            self.mx3 = peek(0xf000 + 2);
            self.my3 = peek(0xf000 + 3);
            self.pmissile3 = 1;
            SCBwrite(3, 0x80, 0x40, self.mx3, self.my3, 8, 8, 0b00000011, 0x00);
        }
        // All three slots busy: the shot is silently dropped
    }

    void updateMissile(self) {
        if (self.pmissile1 == 1) {
            self.my1 -= 6;
            if (self.my1 < 0) {
                self.pmissile1 = 0;
                SCBwrite(1, 0x80, 0x40, 0, 0, 8, 8, 0b00000000, 0x00);
            } else {
                SCBwrite(1, 0x80, 0x40, self.mx1, self.my1, 8, 8, 0b00000011, 0x00);
            }
        }
        if (self.pmissile2 == 1) {
            self.my2 -= 6;
            if (self.my2 < 0) {
                self.pmissile2 = 0;
                SCBwrite(2, 0x80, 0x40, 0, 0, 8, 8, 0b00000000, 0x00);
            } else {
                SCBwrite(2, 0x80, 0x40, self.mx2, self.my2, 8, 8, 0b00000011, 0x00);
            }
        }
        if (self.pmissile3 == 1) {
            self.my3 -= 6;
            if (self.my3 < 0) {
                self.pmissile3 = 0;
                SCBwrite(3, 0x80, 0x40, 0, 0, 8, 8, 0b00000000, 0x00);
            } else {
                SCBwrite(3, 0x80, 0x40, self.mx3, self.my3, 8, 8, 0b00000011, 0x00);
            }
        }
    }
}

void draw_stars(int layer, int step, int color_min, int color_max) {
	int p, x, y, color;
	int start = 0;
	int finish = 65535;
	set_layer(layer);
	for (p = start; p <= finish; p += step) {
		int rnd = random();
		x = (rnd >> 8) & 0xFF;
		y = rnd & 0xFF;
		color = random_range(color_min, color_max);
		set_pos(x, y);
		write_screen(color);
		if (random_range(0,63) == 0) {
			set_color(color);
			draw_circle(1,1);
		}
		if (random_range(0,127) == 0) {
			set_color(color);
			draw_circle(2,1);
		}
	}
}

void parallax() {
	for (int layer = 1; layer <= 4; layer++) {
		set_layer(layer);
		if (layer == 1){
			scroll_y(layer, 1, 1);
		}
		if (layer == 2){
			scroll_y(layer, 1, 2);
		}
		if (layer == 3){
			scroll_y(layer, 1, 3);
		}
		if (layer == 4){
			scroll_y(layer, 1, 4);
		}
	}
}

void memsprite(int addr, int sprite[64]) {
    set_bank(1);
    for (int x = 0; x < 64; x++) {
        poke(addr + x, sprite[x]);
    }
    set_bank(0);
}

void SCBwrite(int id, int addrhi, int addrlo, int x, int y, int w, int h, int flags, int transparency) {
    int base;
    base = 0xF000 + (id * 16);
    poke(base+0, addrhi);
    poke(base+1, addrlo);
    poke(base+2, x);
    poke(base+3, y);
    poke(base+4, w);
    poke(base+5, h);
    poke(base+6, flags);
    poke(base+7, transparency);
}

void sprblit(int id) {
    set_bank(1);
    sprite_blit(id);
    set_bank(0);
}

void loadMissile() {
    int missile[64] = {
        00,00,00,10,10,00,00,00,
        00,00,10,15,15,10,00,00,
        00,00,00,15,15,00,00,00,
        00,00,00,15,15,00,00,00,
        00,00,00,15,15,00,00,00,
        00,00,10,15,15,10,00,00,
        00,10,10,15,15,10,10,00,
        00,00,00,127,127,00,00,00
    };
    memsprite(0x8040, missile);
}

void sprblitall() {
    set_bank(1);
    sprite_blitall();
    set_bank(0);
}

void loadPlayer() {
    int sprite[64] = {
        00,00,00,10,10,00,00,00,
        00,00,15,10,10,15,00,00,
        00,00,00,10,10,00,00,00,
        00,00,00,15,15,00,00,00,
        15,00,15,15,15,15,00,15,
        15,15,08,15,15,08,15,15,
        00,00,31,00,00,31,00,00,
        00,00,127,00,00,127,00,00
    };
    memsprite(0x8000, sprite);
    SCBwrite(0, 0x80, 0x00, 128, 128, 8, 8, 0b00000011, 0x00);
    Player.x = peek(0xf000 + 2);
    Player.y = peek(0xf000 + 3);
}

void main() {
    int counter = 0;
    // Layer 1: many dim stars
	draw_stars(1, 32, 0x00, 0x04);

	// Layer 2: fewer, brighter stars
	draw_stars(2, 128, 0x04, 0x07);

	// Layer 3: fewer, brighter stars
	draw_stars(3, 256, 0x07, 0x0A);

	// Layer 4: fewest, brightest stars
	draw_stars(4, 512, 0x0A, 0x0F);

    loadPlayer();
    loadMissile();

    while (1) {
        counter++;
        if ((counter % 2560) == 0) {
            Missile.updateMissile();
            switch (key_read()) {
                case 119:
                    Player.movePlayer(0);
                    break;
                case 115:
                    Player.movePlayer(1);
                    break;
                case 97:
                    Player.movePlayer(2);
                    break;
                case 100:
                    Player.movePlayer(3);
                    break;
                case 101:
                    Missile.fireMissile();
                    break;
            }
        }
        if ((counter % 5120) == 0) {
            sprblitall();
            parallax();
        }
    }
}