// =============================================================================
// NovaDOS - Timer heartbeat (vector 0)
// WHAT: system_ticks, advanced by a naked timer ISR when
//       NOVADOS_ENABLE_TIMER is 1 (main() arms the timer after disk bring-up).
// WHY: with the timer disabled no vector-0 handler is emitted, so diskless or
//      debug builds pay no ISR bytes and the IVT slot stays empty.
// =============================================================================

include "types.ast";

#ifndef NOVADOS_ENABLE_TIMER
#define NOVADOS_ENABLE_TIMER 1
#endif
#if NOVADOS_ENABLE_TIMER != 0 && NOVADOS_ENABLE_TIMER != 1
#error NOVADOS_ENABLE_TIMER must be 0 or 1
#endif

// Always present so TIME, SYS_TIME and the background task can read it even
// when the ISR is compiled out (it then stays 0).
volatile int system_ticks = 0;

#if NOVADOS_ENABLE_TIMER
// Naked: interrupt entry saves only PC + flags (+ the BANK snapshot), so the
// ISR must not touch a register. INC [abs] increments the word in memory.
// (An earlier version used P0 as scratch and intermittently corrupted the
// interrupted code's P0 -- the ABI return register.) The compiler appends
// the IRET.
naked interrupt(0) void timer_isr() {
    asm("INC {system_ticks}");
}
#endif
