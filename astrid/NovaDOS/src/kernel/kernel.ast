// =============================================================================
// NovaDOS Kernel - entry unit
// WHAT: build settings, boot (signature, disk, timer, tasks) and the shell's
//       keyboard poll loop. Everything else lives in the included units:
//         console.ast    cursor and text output
//         shell.ast      line editor, tokenizer, command table, commands
//         syscall.ast    INT 4 SYS mailbox for loaded programs
//         interrupts.ast timer heartbeat
//         memmgr.ast     kmalloc, sleeper table, optional full scheduler
//         ../fs/ndf.ast  NDF volumes on bank pages
// BUILD: py -3.13 astrid/astrid_compiler.py astrid/NovaDOS/src/kernel/kernel.ast
//            --memory-layout bank-safe     (see docs/plans/build-settings.md)
// =============================================================================

// Build settings live in the entry unit so every included unit sees them.
#ifndef NOVADOS_ENABLE_NDF
#define NOVADOS_ENABLE_NDF 1
#endif
#if NOVADOS_ENABLE_NDF != 0 && NOVADOS_ENABLE_NDF != 1
#error NOVADOS_ENABLE_NDF must be 0 or 1
#endif
#ifndef NOVADOS_POLL_LIMIT
#define NOVADOS_POLL_LIMIT 200
#endif
// The loop counter is signed 16-bit; larger limits would wrap before exit.
#if NOVADOS_POLL_LIMIT < 1 || NOVADOS_POLL_LIMIT > 32767
#error NOVADOS_POLL_LIMIT must be between 1 and 32767
#endif
// Timer heartbeat on vector 0: one tick per (TS+1)*TM = 32*100 = 3200
// cycles, roughly one per poll iteration.
#ifndef NOVADOS_ENABLE_TIMER
#define NOVADOS_ENABLE_TIMER 1
#endif
#if NOVADOS_ENABLE_TIMER != 0 && NOVADOS_ENABLE_TIMER != 1
#error NOVADOS_ENABLE_TIMER must be 0 or 1
#endif
#ifndef NOVADOS_ENABLE_SYSCALLS
#define NOVADOS_ENABLE_SYSCALLS 1
#endif

include "memmgr.ast";
include "interrupts.ast";
include "console.ast";
#if NOVADOS_ENABLE_NDF
include "../fs/ndf.ast";
#endif
include "shell.ast";
include "syscall.ast";

// OS signature "ND" 0x01 0x00 at 0x0000. Placed data is written by the
// loader, so it is in memory before the first instruction runs.
const int os_signature[2] @ OS_SIG = {0x4E44, 0x0100};

#if NOVADOS_ENABLE_NDF
// HI, the sample program on the boot volume: the bytes of src/progs/hi.asm
// assembled for PROG_BASE. Keep the two in sync (a test checks).
const char hi_prog[36] = {
    0x06, 0x08, 0xF1, 0x58, 0x17, 0x06, 0x83, 0x00, 0x16, 0xF1, 0x06, 0x04,
    0xF1, 0x09, 0x06, 0x83, 0x00, 0x12, 0xF1, 0x30, 0x01, 0x04, 0x01, 0x48,
    0x49, 0x20, 0x46, 0x52, 0x4F, 0x4D, 0x20, 0x44, 0x49, 0x53, 0x4B, 0x00
};

// Bank 1 is the boot volume: bank 0 aliases base RAM, so 1 is the first
// private page. RAM banks start empty, so the volume is built at boot.
void disk_init() {
    ndf_format(1);
    ndf_create(1, "BOOT", NDF_TEXT, "HELLO", 5);
    ndf_create(1, "HI", NDF_PROG, hi_prog, sizeof(hi_prog));
}
#endif

void banner() {
    set_mode(1);
    con_clear();
    set_pos(16, 8);
    write_text("NovaDOS v0.2", CON_FG);
    set_pos(16, 16);
    write_text("Astrid kernel - type HELP", CON_ACCENT);
}

// ---------------------------------------------------------------------------
// Tasks: the shell runs on the boot stack; the background task runs
// housekeeping once per shell poll and yields straight back.
// ---------------------------------------------------------------------------
int shell_ctx[22];
int bg_ctx[22];
int bg_stack[64];
int bg_runs = 0;            // background passes since boot

// A spawned task must never return: task_spawn parks only the entry address
// on the new stack, so a RET from here would pop garbage.
void bg_task() {
    while (1) {
        wake_sleepers(system_ticks);
        bg_runs++;
        task_switch(bg_ctx, shell_ctx);
    }
}

void main() {
    int polls;
    sched_init();
    banner();
#if NOVADOS_ENABLE_NDF
    // Before the timer is armed, so formatting runs interrupt-free.
    disk_init();
#endif
#if NOVADOS_ENABLE_TIMER
    // TC=3: count enable + interrupt enable (unmasks vector 0). Raw register
    // writes: asm is a compiler barrier, so the sequence stays in order.
    asm("MOV TT, 0");
    asm("MOV TM, 100");
    asm("MOV TS, 31");
    asm("MOV TC, 3");
#endif
#if NOVADOS_ENABLE_TIMER || NOVADOS_ENABLE_SYSCALLS
    // Global interrupt enable: the timer needs it, and INT 4 is ignored
    // without it.
    asm("STI");
#endif
    task_spawn(bg_ctx, bg_stack, 64, &bg_task);
    shell_prompt();
    // Bounded so headless runs terminate; BYE/Esc leave early.
    for (polls = 0; polls < NOVADOS_POLL_LIMIT && !shell_exit; polls++) {
        task_switch(shell_ctx, bg_ctx);
        if (key_available()) {
            shell_key(key_read());
        }
    }
    if (con_col != CON_LEFT) {
        con_newline();
    }
    con_println("System halted.");
}
