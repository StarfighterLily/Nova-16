// =============================================================================
// NovaDOS Kernel - Type Definitions
// WHAT: minimal scalar-only structs the Astrid parser accepts.
// WHY: struct fields must be scalar base types; arrays and struct pointers are
//      variables, not fields. Task contexts/stacks live as parallel globals in
//      memmgr.ast (gated by NOVADOS_ENABLE_FULL_SCHEDULER).
// =============================================================================

include "../kdos.ast";

struct FDEntry {
    int ftype;
    int flags;
    int offset;
    int handle;
    int pid;
};

struct DirEntry {
    string name;
    int ftype;
    int fsize;
    int cluster;
    int attrs;
};

struct ProcEntry {
    int pid;
    int parent;
    int argc;
    int arg0;
    int arg1;
    int exitcode;
    int state;
    int taskidx;
};
