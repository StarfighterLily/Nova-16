// =============================================================================
// NovaDOS Kernel - Type Definitions
// WHAT: records for the open-file, directory and process tables of the later
//       phases (Plan-9 device files, multitasking). Nothing instantiates them
//       yet; they cost nothing until a variable of the type exists.
// NOTE: the on-disk directory record lives with its users in fs/ndf.ast
//       (struct NdfEntry).
// =============================================================================

include "../kdos.ast";

struct FDEntry {
    int ftype;
    int flags;
    int offset;
    int handle;
    int pid;
};

struct DirEntry {
    string name;
    int ftype;
    int fsize;
    int cluster;
    int attrs;
};

struct ProcEntry {
    int pid;
    int parent;
    int argc;
    int arg0;
    int arg1;
    int exitcode;
    int state;
    int taskidx;
};
