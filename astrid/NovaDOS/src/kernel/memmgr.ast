// =============================================================================
// NovaDOS - Memory Manager + Cooperative Scheduler State
// WHAT: kmalloc bump heap, the sleeper table the background task services,
//       and (opt-in) the full multi-task create/yield path.
// WHY: the boot kernel runs two cooperative tasks (shell + background) on the
//      task_spawn/task_switch builtins; the 16-slot TCB with per-task stacks
//      costs ~3 KB and stays behind NOVADOS_ENABLE_FULL_SCHEDULER.
// =============================================================================

include "types.ast";

// =============================================================================
// Build-time scheduler capacity
// =============================================================================
#ifndef NOVADOS_MAX_TASKS
#define NOVADOS_MAX_TASKS 16
#endif
#if NOVADOS_MAX_TASKS < 1 || NOVADOS_MAX_TASKS > 16
#error NOVADOS_MAX_TASKS must be between 1 and 16
#endif
#ifndef NOVADOS_TASK_STACK_WORDS
#define NOVADOS_TASK_STACK_WORDS 64
#endif
#if NOVADOS_TASK_STACK_WORDS < 32 || NOVADOS_TASK_STACK_WORDS > 256
#error NOVADOS_TASK_STACK_WORDS must be between 32 and 256
#endif
#ifndef NOVADOS_ENABLE_FULL_SCHEDULER
#define NOVADOS_ENABLE_FULL_SCHEDULER 0
#endif
#if NOVADOS_ENABLE_FULL_SCHEDULER != 0 && NOVADOS_ENABLE_FULL_SCHEDULER != 1
#error NOVADOS_ENABLE_FULL_SCHEDULER must be 0 or 1
#endif

// =============================================================================
// kmalloc: bump allocator over KHEAP_START..KHEAP_END, word aligned.
// =============================================================================
// WHY its own range: the heap used to start at 0x3000, which under the
// bank-safe layout is inside kernel code (0x1100-0x41FF) and below the
// globals at 0x4200 -- the first allocation would have overwritten code.
// The kernel test suite checks that every global ends below KHEAP_START.

int mem_heap_next = KHEAP_START;

int kmalloc(int size) {
    int addr;
    size = (size + 1) & 0xFFFE;
    if (size > KHEAP_END - mem_heap_next) {
        return 0;
    }
    addr = mem_heap_next;
    mem_heap_next += size;
    return addr;
}

// Bump allocator: blocks have no headers, so free cannot reclaim anything.
// Kept so callers can be written against the usual pair.
void kfree(int ptr) {
}

int kmalloc_free() {
    return KHEAP_END - mem_heap_next;
}

// =============================================================================
// Sleeper table (always present; tiny)
// =============================================================================
// task_state[i] == TASK_SLEEPING with task_wake[i] <= now becomes TASK_READY
// the next time the background task runs wake_sleepers().

int task_pid[NOVADOS_MAX_TASKS];
int task_state[NOVADOS_MAX_TASKS];
int task_wake[NOVADOS_MAX_TASKS];
int task_count = 0;
int current_task = -1;

void sched_init() {
    int i;
    for (i = 0; i < NOVADOS_MAX_TASKS; i++) {
        task_pid[i] = -1;
        task_state[i] = TASK_STOPPED;
    }
}

void wake_sleepers(int now) {
    int i;
    for (i = 0; i < NOVADOS_MAX_TASKS; i++) {
        if (task_state[i] == TASK_SLEEPING && task_wake[i] <= now) {
            task_state[i] = TASK_READY;
        }
    }
}

// =============================================================================
// Full multi-task create/yield path (opt-in)
// =============================================================================

#if NOVADOS_ENABLE_FULL_SCHEDULER

// Slot i owns ctx_words[i*22 ..] and NOVADOS_TASK_STACK_WORDS words of
// task_stacks from i*NOVADOS_TASK_STACK_WORDS. The tables must end below
// KHEAP_START (the kernel tests check the built image).
int ctx_words[NOVADOS_MAX_TASKS * 22];
int task_stacks[NOVADOS_MAX_TASKS * NOVADOS_TASK_STACK_WORDS];
int task_prio[NOVADOS_MAX_TASKS];

int find_free_task_slot() {
    int i;
    for (i = 0; i < NOVADOS_MAX_TASKS; i++) {
        if (task_pid[i] == -1) {
            return i;
        }
    }
    return -1;
}

// The context lives directly in the slot's ctx_words window: task_spawn and
// task_switch take the window's address, so nothing is copied.
int task_create(int entry, int priority) {
    int slot;
    slot = find_free_task_slot();
    if (slot < 0) {
        return -1;
    }
    task_spawn(&ctx_words[slot * 22], &task_stacks[slot * NOVADOS_TASK_STACK_WORDS],
               NOVADOS_TASK_STACK_WORDS, entry);
    task_pid[slot] = slot;
    task_prio[slot] = priority;
    task_state[slot] = TASK_READY;
    task_wake[slot] = 0;
    task_count++;
    return slot;
}

// Switch to the highest-priority READY task other than the current one.
void task_yield() {
    int old_task;
    int new_task;
    int best_prio;
    int i;
    old_task = current_task;
    if (old_task < 0 || task_count <= 1) {
        return;
    }
    best_prio = -1;
    new_task = -1;
    for (i = 0; i < NOVADOS_MAX_TASKS; i++) {
        if (i != old_task && task_state[i] == TASK_READY && task_pid[i] != -1
                && task_prio[i] > best_prio) {
            best_prio = task_prio[i];
            new_task = i;
        }
    }
    if (new_task < 0) {
        return;
    }
    current_task = new_task;
    task_switch(&ctx_words[old_task * 22], &ctx_words[new_task * 22]);
}

void task_sleep(int until) {
    if (current_task < 0) {
        return;
    }
    task_state[current_task] = TASK_SLEEPING;
    task_wake[current_task] = until;
    task_yield();
}

#endif
