// =============================================================================
// NovaDOS - NDF (NovaDisk) Volume Layer
// WHAT: byte/word access to a hardware bank page, plus the NDF on-disk format:
//       header "NDF1" + entry count, 16-byte directory entries starting at
//       window offset 0x0010, file bytes from 0x0400.
// WHY: bank pages are OS "disks" via BANK into 0x8000-0xBFFF; only safe under
//      Astrid bank-safe layout. Every accessor restores bank 0; Pure Option B
//      makes brackets interrupt-safe. Geometry is enums (immediates).
// =============================================================================

enum NdfGeom {
    NDF_WINDOW      = 0x8000,
    NDF_ENTRY_BASE  = 0x0010,
    NDF_ENTRY_SIZE  = 16,
    NDF_NAME_LEN    = 8,
    NDF_DATA_BASE   = 0x0400,
    NDF_MAX_ENTRIES = 16,
    NDF_CLUSTER     = 256
};

enum NdfAlias {
    ndf_window      = NDF_WINDOW,
    ndf_entry_base  = NDF_ENTRY_BASE,
    ndf_entry_size  = NDF_ENTRY_SIZE,
    ndf_name_len    = NDF_NAME_LEN,
    ndf_data_base   = NDF_DATA_BASE,
    ndf_max_entries = NDF_MAX_ENTRIES,
    ndf_cluster     = NDF_CLUSTER
};

int ndf_read8(int bank, int offset) {
    int v;
    set_bank(bank);
    v = peek(NDF_WINDOW + offset);
    set_bank(0);
    return v;
}

void ndf_write8(int bank, int offset, int value) {
    set_bank(bank);
    poke(NDF_WINDOW + offset, value);
    set_bank(0);
}

int ndf_read16(int bank, int offset) {
    int hi;
    int lo;
    set_bank(bank);
    hi = peek(NDF_WINDOW + offset);
    lo = peek(NDF_WINDOW + offset + 1);
    set_bank(0);
    return hi * 256 + lo;
}

void ndf_write16(int bank, int offset, int value) {
    int hi;
    int lo;
    hi = (value >> 8) & 0xFF;
    lo = value & 0xFF;
    set_bank(bank);
    poke(NDF_WINDOW + offset, hi);
    poke(NDF_WINDOW + offset + 1, lo);
    set_bank(0);
}

void ndf_format(int bank) {
    set_bank(bank);
    poke(NDF_WINDOW + 0, 78);
    poke(NDF_WINDOW + 1, 68);
    poke(NDF_WINDOW + 2, 70);
    poke(NDF_WINDOW + 3, 49);
    poke(NDF_WINDOW + 4, 0);
    poke(NDF_WINDOW + 5, 0);
    set_bank(0);
}

int ndf_mounted(int bank) {
    int ok;
    set_bank(bank);
    ok = 0;
    if (peek(NDF_WINDOW + 0) == 78) {
        if (peek(NDF_WINDOW + 1) == 68) {
            if (peek(NDF_WINDOW + 2) == 70) {
                if (peek(NDF_WINDOW + 3) == 49) {
                    ok = 1;
                }
            }
        }
    }
    set_bank(0);
    return ok;
}

int ndf_entry_count(int bank) {
    return ndf_read16(bank, 4);
}

int ndf_name_byte(int bank, int slot, int index) {
    return ndf_read8(bank, NDF_ENTRY_BASE + slot * NDF_ENTRY_SIZE + index);
}

int ndf_entry_type(int bank, int slot) {
    return ndf_read8(bank, NDF_ENTRY_BASE + slot * NDF_ENTRY_SIZE + 8);
}

int ndf_entry_size(int bank, int slot) {
    return ndf_read16(bank, NDF_ENTRY_BASE + slot * NDF_ENTRY_SIZE + 10);
}

// Entry-point / data offset word at +12 of the directory record.
int ndf_entry_data(int bank, int slot) {
    return ndf_read16(bank, NDF_ENTRY_BASE + slot * NDF_ENTRY_SIZE + 12);
}

int ndf_add(int bank, int c0, int c1, int c2, int c3, int type, int size) {
    int count;
    int base;
    int data_off;
    int new_count;
    count = ndf_entry_count(bank);
    if (count >= NDF_MAX_ENTRIES) {
        return -1;
    }
    base = NDF_ENTRY_BASE + count * NDF_ENTRY_SIZE;
    data_off = NDF_DATA_BASE + count * NDF_CLUSTER;
    new_count = count + 1;
    set_bank(bank);
    poke(NDF_WINDOW + base + 0, c0);
    poke(NDF_WINDOW + base + 1, c1);
    poke(NDF_WINDOW + base + 2, c2);
    poke(NDF_WINDOW + base + 3, c3);
    poke(NDF_WINDOW + base + 4, 0);
    poke(NDF_WINDOW + base + 5, 0);
    poke(NDF_WINDOW + base + 6, 0);
    poke(NDF_WINDOW + base + 7, 0);
    poke(NDF_WINDOW + base + 8, type);
    poke(NDF_WINDOW + base + 9, 0);
    poke(NDF_WINDOW + base + 10, (size >> 8) & 0xFF);
    poke(NDF_WINDOW + base + 11, size & 0xFF);
    poke(NDF_WINDOW + base + 12, (data_off >> 8) & 0xFF);
    poke(NDF_WINDOW + base + 13, data_off & 0xFF);
    poke(NDF_WINDOW + base + 14, 0);
    poke(NDF_WINDOW + base + 15, 0);
    poke(NDF_WINDOW + 4, (new_count >> 8) & 0xFF);
    poke(NDF_WINDOW + 5, new_count & 0xFF);
    set_bank(0);
    return new_count;
}

