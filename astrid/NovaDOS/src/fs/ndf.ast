// =============================================================================
// NovaDOS - NDF (NovaDisk) Volume Layer
// WHAT: named files on hardware bank pages. Each of banks 1-15 can hold one
//       NDF volume, seen through the 16 KB window at 0x8000-0xBFFF.
//
//   Volume layout (offsets into the window, all words big-endian):
//     0x0000  "NDF1"            magic
//     0x0004  count             directory entries in use (0..16)
//     0x0006  next_free         first unallocated data byte (bump allocator)
//     0x0010  directory         16 entries x 16 bytes (struct NdfEntry)
//     0x0400  file data         contiguous, in creation order, to 0x3FFF
//
//   Directory entry (16 bytes):
//     +0  name[8]   NUL-padded, uppercase by convention
//     +8  type      NDF_TEXT / NDF_PROG
//     +9  flags     reserved, 0
//     +10 size      bytes
//     +12 data      window offset of the first data byte
//     +14 reserved
//
// WHY bank brackets: every public function maps its bank, works, and maps
// bank 0 back, so callers never run with a disk visible. Only valid under
// the bank-safe layout, where nothing the kernel needs (globals, string
// scratch, spills, stack) lives in the window. Interrupts are safe inside a
// bracket: entry snapshots BANK and forces bank 0, IRET restores it.
// Buffers passed as src/dst must lie outside 0x8000-0xBFFF.
// =============================================================================

enum NdfGeom {
    NDF_WINDOW      = 0x8000,
    NDF_HDR_COUNT   = 0x0004,
    NDF_HDR_FREE    = 0x0006,
    NDF_ENTRY_BASE  = 0x0010,
    NDF_ENTRY_SIZE  = 16,
    NDF_NAME_LEN    = 8,
    NDF_MAX_ENTRIES = 16,
    NDF_DATA_BASE   = 0x0400,
    NDF_DATA_END    = 0x4000
};

enum NdfType {
    NDF_TEXT = 0,
    NDF_PROG = 1
};

// Negative results of ndf_create / ndf_find.
enum NdfError {
    NDF_ENOENT  = -1,   // no such file
    NDF_EFULL   = -2,   // directory full
    NDF_ENOSPC  = -3,   // not enough data space
    NDF_EEXIST  = -4,   // name already in use
    NDF_ENAME   = -5    // name empty or longer than 8 bytes
};

struct NdfEntry {
    int name01;
    int name23;
    int name45;
    int name67;
    // Bit-fields pack from the low bit up and words are big-endian, so the
    // first field is the byte at +9 and the second the byte at +8.
    unsigned int flags : 8;
    unsigned int type  : 8;
    int size;
    int data;
    int reserved;
};

static_assert(sizeof(struct NdfEntry) == NDF_ENTRY_SIZE, "NDF entry must be 16 bytes");
static_assert(NDF_ENTRY_BASE + NDF_MAX_ENTRIES * NDF_ENTRY_SIZE <= NDF_DATA_BASE,
              "NDF directory overlaps the data area");
static_assert(NDF_DATA_END <= 0x4000, "NDF data must fit the 16 KB bank window");

// ---------------------------------------------------------------------------
// Helpers that expect the volume's bank to be mapped already.
// ---------------------------------------------------------------------------

// Window address of directory slot `slot`.
int ndf_entry_addr(int slot) {
    return NDF_WINDOW + NDF_ENTRY_BASE + slot * NDF_ENTRY_SIZE;
}

// 1 when the 8-byte entry name at `ent` equals the NUL-terminated `name`.
int ndf_name_eq(int ent, string name) {
    int i;
    int c;
    for (i = 0; i < NDF_NAME_LEN; i++) {
        c = peek(name + i);
        if (peek(ent + i) != c) {
            return 0;
        }
        if (c == 0) {
            return 1;
        }
    }
    // All eight bytes matched; the name must end here too.
    return peek(name + NDF_NAME_LEN) == 0;
}

int ndf_find_mapped(string name) {
    int slot;
    int count;
    count = peek2(NDF_WINDOW + NDF_HDR_COUNT);
    for (slot = 0; slot < count; slot++) {
        if (ndf_name_eq(ndf_entry_addr(slot), name)) {
            return slot;
        }
    }
    return NDF_ENOENT;
}

// ---------------------------------------------------------------------------
// Public API: each call brackets its own bank switch.
// ---------------------------------------------------------------------------

void ndf_format(int bank) {
    set_bank(bank);
    // Zero the header and directory, then stamp the magic.
    memset(NDF_WINDOW, 0, NDF_DATA_BASE);
    poke2(NDF_WINDOW, 0x4E44);                 // "ND"
    poke2(NDF_WINDOW + 2, 0x4631);             // "F1"
    poke2(NDF_WINDOW + NDF_HDR_FREE, NDF_DATA_BASE);
    set_bank(0);
}

int ndf_mounted(int bank) {
    int ok;
    set_bank(bank);
    ok = peek2(NDF_WINDOW) == 0x4E44 && peek2(NDF_WINDOW + 2) == 0x4631;
    set_bank(0);
    return ok;
}

int ndf_count(int bank) {
    int n;
    set_bank(bank);
    n = peek2(NDF_WINDOW + NDF_HDR_COUNT);
    set_bank(0);
    return n;
}

// Bytes still free for file data on the volume.
int ndf_free(int bank) {
    int n;
    set_bank(bank);
    n = NDF_DATA_END - peek2(NDF_WINDOW + NDF_HDR_FREE);
    set_bank(0);
    return n;
}

int ndf_find(int bank, string name) {
    int slot;
    set_bank(bank);
    slot = ndf_find_mapped(name);
    set_bank(0);
    return slot;
}

// Create file `name` holding `len` bytes copied from `src` (which must not
// lie in the bank window). Returns the new slot or a negative NdfError.
int ndf_create(int bank, string name, int type, int src, int len) {
    int count;
    int data;
    int slot;
    int namelen;
    struct NdfEntry *e;
    namelen = strlen(name);
    if (namelen == 0 || namelen > NDF_NAME_LEN) {
        return NDF_ENAME;
    }
    set_bank(bank);
    count = peek2(NDF_WINDOW + NDF_HDR_COUNT);
    data = peek2(NDF_WINDOW + NDF_HDR_FREE);
    if (ndf_find_mapped(name) >= 0) {
        slot = NDF_EEXIST;
    } else if (count >= NDF_MAX_ENTRIES) {
        slot = NDF_EFULL;
    } else if (len > NDF_DATA_END - data) {
        slot = NDF_ENOSPC;
    } else {
        slot = count;
        e = ndf_entry_addr(slot);
        strncpy(e, name, NDF_NAME_LEN);        // NUL-pads to 8 bytes
        e->type = type;
        e->flags = 0;
        e->size = len;
        e->data = data;
        e->reserved = 0;
        memcpy(NDF_WINDOW + data, src, len);
        poke2(NDF_WINDOW + NDF_HDR_COUNT, count + 1);
        poke2(NDF_WINDOW + NDF_HDR_FREE, data + len);
    }
    set_bank(0);
    return slot;
}

int ndf_size(int bank, int slot) {
    int n;
    struct NdfEntry *e;
    set_bank(bank);
    e = ndf_entry_addr(slot);
    n = e->size;
    set_bank(0);
    return n;
}

int ndf_type(int bank, int slot) {
    int t;
    struct NdfEntry *e;
    set_bank(bank);
    e = ndf_entry_addr(slot);
    t = e->type;
    set_bank(0);
    return t;
}

// Copy the 8-byte name of `slot` to dst[0..8], NUL-terminated.
void ndf_name(int bank, int slot, int dst) {
    set_bank(bank);
    memcpy(dst, ndf_entry_addr(slot), NDF_NAME_LEN);
    set_bank(0);
    poke(dst + NDF_NAME_LEN, 0);
}

// Copy up to `max` bytes of file `slot`, starting `offset` bytes in, to
// `dst` (which must lie outside the bank window). Returns the byte count,
// 0 at or past the end of the file.
int ndf_read(int bank, int slot, int offset, int dst, int max) {
    int n;
    struct NdfEntry *e;
    set_bank(bank);
    e = ndf_entry_addr(slot);
    n = 0;
    if (offset < e->size) {
        n = e->size - offset;
        if (n > max) {
            n = max;
        }
        memcpy(dst, NDF_WINDOW + e->data + offset, n);
    }
    set_bank(0);
    return n;
}
