void setup() {
	set_vmode(1);           // Memory mode
	set_pos(0, 0);         // VX = 0, VY = 0
}

void draw_stars(int layer, int step, int color_min, int color_max) {
	int p, x, y, color;
	int start = 0;
	int finish = 65535;
	set_layer(layer);
	for (p = start; p <= finish; p += step) {
		int rnd = random();
		x = (rnd >> 8) & 0xFF;
		y = rnd & 0xFF;
		color = random_range(color_min, color_max);
		set_pos(x, y);
		write_screen(color);
	}
}

void draw_text() {
	set_layer(5);
	set_vmode(0);
	set_pos(101, 123);
	write_text("StarField", 0x15); // Shadow
	set_pos(100, 124);
	write_text("StarField", 0x1F); // Main
}

void parallax() {
	for (int layer = 1; layer <= 4; layer++) {
		set_layer(layer);
		if (layer == 1){
			scroll_x(layer, 0, 1);
		}
		if (layer == 2){
			scroll_x(layer, 0, 2);
		}
		if (layer == 3){
			scroll_x(layer, 0, 3);
		}
		if (layer == 4){
			scroll_x(layer, 0, 4);
		}
	}
	for (int i= 0; i < 2500; i++) {
		nop();
	}
}

void main() {
	setup();

	// Layer 1: many dim stars
	draw_stars(1, 32, 0x00, 0x04);

	// Layer 2: fewer, brighter stars
	draw_stars(2, 128, 0x04, 0x07);

	// Layer 3: fewer, brighter stars
	draw_stars(3, 256, 0x07, 0x0A);

	// Layer 4: fewest, brightest stars
	draw_stars(4, 512, 0x0A, 0x0F);

	//draw_text();

	sti();	// enable interrupts
	set_timer(0, 255, 255, 3);     // TT, TM, TS, TC

	while (1) {
		// Infinite loop
	}
}

// Timer interrupt handler (vector at 0x0100)
void timer_interrupt() {
	set_timer(0, 255, 255, 0);    // disable timer to do our thing because
	parallax();                   // We'll be in here a goodly amount of cycles
	set_timer(0, 255, 255, 3);    // Now re-enable timer
}