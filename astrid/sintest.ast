int counter = 0;
int x = 0;
int y = 0;
int oldx;
int oldy;
int center_y = 128;
int amplitude = 32;
float frequency = 8.0 * 3.14 / 128;

void sine() {
    y = center_y + (int)(sin(x * (frequency)) * (amplitude));
}

void main() {
    set_mode(1);
    set_layer(1);
    set_pos(0,0);
    set_color(0x00);

    while (1) {
        counter++;
        oldx = x;
        oldy = y;
        x++;
        if (x == 255) {
            x = 0;
        }
        if ((counter % 60) == 0) {
            screen_fill(0x00);
            sine();
            set_pos(y, x);
            set_color(0x5F);
            draw_circle(1, 1);
            counter = 0;
        }
    }
}