int x = 0;
int y = 0;
int oldx;
int oldy;
int center_y = 128;
int amplitude = 128;
float frequency = 8.0 * 3.14 / 128;

void sine() {
    y = center_y + (int)(sin(x * (frequency)) * (amplitude));
}

void main() {
    set_mode(1);
    set_layer(1);
    set_pos(0,0);
    set_color(0x00);
    sti();	// enable interrupts
	set_timer(0, 255, 256, 3);     // TT, TM, TS, TC
    while (1) {
    }
}

void timer_interrupt() {
    set_timer(0, 255, 255, 0);
    oldx = x;
    oldy = y;
    x++;
    if (x == 255) {
        x = 0;
    }
    if (x % 2) {
        screen_fill(0x00);
    }
    sine();
    set_pos(y, x);
    write_screen(0x5F);
    set_timer(0, 255, 255, 3);
}