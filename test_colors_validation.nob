REM Color Validation Test
REM Validates color system correctness and edge cases

CLRHOME

REM Test color constant values
DISP "Validating color constants:"

Y_POS = 10
FOR I = 0 TO 16
    IF I = 0 THEN
        EXPECTED_VALUE = 0
        COLOR_NAME = "BLACK"
    ELSEIF I = 1 THEN
        EXPECTED_VALUE = 15
        COLOR_NAME = "WHITE"
    ELSEIF I = 2 THEN
        EXPECTED_VALUE = 20
        COLOR_NAME = "RED"
    ELSEIF I = 3 THEN
        EXPECTED_VALUE = 36
        COLOR_NAME = "GREEN"
    ELSEIF I = 4 THEN
        EXPECTED_VALUE = 52
        COLOR_NAME = "BLUE"
    ELSEIF I = 5 THEN
        EXPECTED_VALUE = 68
        COLOR_NAME = "YELLOW"
    ELSEIF I = 6 THEN
        EXPECTED_VALUE = 84
        COLOR_NAME = "MAGENTA"
    ELSEIF I = 7 THEN
        EXPECTED_VALUE = 100
        COLOR_NAME = "CYAN"
    ELSEIF I = 8 THEN
        EXPECTED_VALUE = 116
        COLOR_NAME = "ORANGE"
    ELSEIF I = 9 THEN
        EXPECTED_VALUE = 132
        COLOR_NAME = "PURPLE"
    ELSEIF I = 10 THEN
        EXPECTED_VALUE = 148
        COLOR_NAME = "LIME"
    ELSEIF I = 11 THEN
        EXPECTED_VALUE = 164
        COLOR_NAME = "PINK"
    ELSEIF I = 12 THEN
        EXPECTED_VALUE = 180
        COLOR_NAME = "TEAL"
    ELSEIF I = 13 THEN
        EXPECTED_VALUE = 196
        COLOR_NAME = "BROWN"
    ELSEIF I = 14 THEN
        EXPECTED_VALUE = 212
        COLOR_NAME = "LIGHTBLUE"
    ELSEIF I = 15 THEN
        EXPECTED_VALUE = 228
        COLOR_NAME = "LIGHTGREEN"
    ELSEIF I = 16 THEN
        EXPECTED_VALUE = 244
        COLOR_NAME = "LIGHTRED"
    END IF

    DISP "Color " + STR(I) + ": " + COLOR_NAME + " (expected: " + STR(EXPECTED_VALUE) + ")"

    IF I = 0 THEN
        ACTUAL_VALUE = BLACK
    ELSEIF I = 1 THEN
        ACTUAL_VALUE = WHITE
    ELSEIF I = 2 THEN
        ACTUAL_VALUE = RED
    ELSEIF I = 3 THEN
        ACTUAL_VALUE = GREEN
    ELSEIF I = 4 THEN
        ACTUAL_VALUE = BLUE
    ELSEIF I = 5 THEN
        ACTUAL_VALUE = YELLOW
    ELSEIF I = 6 THEN
        ACTUAL_VALUE = MAGENTA
    ELSEIF I = 7 THEN
        ACTUAL_VALUE = CYAN
    ELSEIF I = 8 THEN
        ACTUAL_VALUE = ORANGE
    ELSEIF I = 9 THEN
        ACTUAL_VALUE = PURPLE
    ELSEIF I = 10 THEN
        ACTUAL_VALUE = LIME
    ELSEIF I = 11 THEN
        ACTUAL_VALUE = PINK
    ELSEIF I = 12 THEN
        ACTUAL_VALUE = TEAL
    ELSEIF I = 13 THEN
        ACTUAL_VALUE = BROWN
    ELSEIF I = 14 THEN
        ACTUAL_VALUE = LIGHTBLUE
    ELSEIF I = 15 THEN
        ACTUAL_VALUE = LIGHTGREEN
    ELSEIF I = 16 THEN
        ACTUAL_VALUE = LIGHTRED
    END IF

    IF ACTUAL_VALUE = EXPECTED_VALUE THEN
        DISP "  PASS"
        PXLON(200, Y_POS, GREEN)
    ELSE
        DISP "  FAIL"
        PXLON(200, Y_POS, RED)
    END IF

    Y_POS = Y_POS + 10
NEXT I

REM Test COLOR() function bounds
DISP "Testing COLOR() bounds:"

REM Test valid ranges
VALID_TESTS = 0
FOR R = 0 TO 15
    FOR S = 0 TO 15
        C = COLOR(R, S)
        EXPECTED = (R * 16) + S
        IF C = EXPECTED THEN
            VALID_TESTS = VALID_TESTS + 1
        END IF
    NEXT S
NEXT R

DISP "Valid COLOR() combinations: " + STR(VALID_TESTS) + "/256"
IF VALID_TESTS = 256 THEN
    DISP "All COLOR() tests passed"
    PXLON(10, 200, GREEN)
ELSE
    DISP "Some COLOR() tests failed"
    PXLON(10, 200, RED)
END IF

REM Test RAMP() and SHADE() extraction
DISP "Testing RAMP() and SHADE() extraction:"

EXTRACTION_TESTS = 0
FOR R = 0 TO 15
    FOR S = 0 TO 15
        ORIGINAL = (R * 16) + S
        EXTRACTED_R = RAMP(ORIGINAL)
        EXTRACTED_S = SHADE(ORIGINAL)

        IF EXTRACTED_R = R AND EXTRACTED_S = S THEN
            EXTRACTION_TESTS = EXTRACTION_TESTS + 1
        END IF
    NEXT S
NEXT R

DISP "Valid extractions: " + STR(EXTRACTION_TESTS) + "/256"
IF EXTRACTION_TESTS = 256 THEN
    DISP "All extraction tests passed"
    PXLON(30, 200, GREEN)
ELSE
    DISP "Some extraction tests failed"
    PXLON(30, 200, RED)
END IF

REM Test round-trip conversion
DISP "Testing round-trip conversion:"

ROUND_TRIP_TESTS = 0
FOR C = 0 TO 255
    R = RAMP(C)
    S = SHADE(C)
    RECREATED = COLOR(R, S)

    IF RECREATED = C THEN
        ROUND_TRIP_TESTS = ROUND_TRIP_TESTS + 1
    END IF
NEXT C

DISP "Round-trip conversions: " + STR(ROUND_TRIP_TESTS) + "/256"
IF ROUND_TRIP_TESTS = 256 THEN
    DISP "All round-trip tests passed"
    PXLON(50, 200, GREEN)
ELSE
    DISP "Some round-trip tests failed"
    PXLON(50, 200, RED)
END IF

REM Test color arithmetic
DISP "Testing color arithmetic:"

RED_COL = RED
BLUE_COL = BLUE
SUM_COLOR = RED_COL + BLUE_COL
DIFF_COLOR = RED_COL - BLUE_COL

DISP "RED + BLUE = " + STR(SUM_COLOR)
DISP "RED - BLUE = " + STR(DIFF_COLOR)

REM Draw test pixels
PXLON(100, 200, RED_COL)
PXLON(110, 200, BLUE_COL)
PXLON(120, 200, SUM_COLOR)
PXLON(130, 200, DIFF_COLOR)

PAUSE