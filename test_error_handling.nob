REM Test error handling
REM Tests TRY/CATCH blocks and error recovery

ClrHome
Disp "Testing error handling"

REM Test division by zero handling
TRY
    A = 10
    B = 0
    C = A / B  REM This should cause an error
    Disp "Division result:", C
CATCH
    Disp "Caught division by zero error"
END TRY

REM Test array bounds checking
TRY
    DIM Array(5)
    Array(10) = 42  REM Out of bounds
    Disp "Array access successful"
CATCH
    Disp "Caught array bounds error"
END TRY

REM Test invalid function calls
REM TRY
REM     Result = INVALID_FUNCTION(123)
REM     Disp "Invalid function result:", Result
REM CATCH
REM     Disp "Caught invalid function error"
REM END TRY

REM Test string operation errors
TRY
    Str = "hello"
    Char = MID(Str, 100, 1)  REM Out of bounds
    Disp "String operation successful"
CATCH
    Disp "Caught string bounds error"
END TRY

REM Test nested error handling
TRY
    TRY
        X = 1 / 0
    CATCH
        Disp "Inner catch: division by zero"
        REM Now cause another error
        Y = Z / 0  REM Z undefined
    END TRY
    Disp "Inner try completed"
CATCH
    Disp "Outer catch: undefined variable"
END TRY

Disp "Error handling test complete"