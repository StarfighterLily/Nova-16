REM Test REPEAT/UNTIL constructs
REM Tests REPEAT/UNTIL loops with various conditions

ClrHome
Disp "Testing REPEAT/UNTIL"

REM Basic REPEAT/UNTIL
A = 0
REPEAT
    A = A + 1
    Disp "Repeat count:", A
UNTIL A >= 3

Disp "Basic repeat done"

REM REPEAT with complex condition
B = 10
REPEAT
    Disp "Countdown:", B
    B = B - 2
UNTIL B <= 0

Disp "Countdown done"

REM Nested REPEAT/UNTIL
X = 0
REPEAT
    Y = 0
    REPEAT
        Disp "Nested repeat:", X, Y
        Y = Y + 1
    UNTIL Y >= 2
    X = X + 1
UNTIL X >= 2

Disp "Nested repeat done"