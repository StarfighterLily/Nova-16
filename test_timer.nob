REM Test timer and interrupt functionality
REM Tests timer registers and interrupt handling

ClrHome
Disp "Testing timer/interrupts"

REM Test timer setup
TT = 1000  REM Timer value
TM = 2000  REM Match value
TC = 1     REM Enable timer, auto-reload
TS = 10    REM Speed divisor

Disp "Timer configured:"
Disp "TT =", TT
Disp "TM =", TM
Disp "TC =", TC
Disp "TS =", TS

REM Test timer reading
Current = TT
Disp "Current timer:", Current

REM Test interrupt vector setup
REM (This would normally be done in assembly)
Disp "Interrupt vectors would be set here"

REM Simulate timer-based loop
Counter = 0
StartTime = TT
DO
    CurrentTime = TT
    If CurrentTime <> StartTime Then
        Counter = Counter + 1
        Disp "Timer tick:", Counter
        StartTime = CurrentTime
    EndIf
LOOP WHILE Counter < 5

Disp "Timer test complete"

REM Test interrupt enable/disable
Disp "Interrupts enabled"
REM IRET would be used in interrupt handlers
Disp "Interrupt test complete"