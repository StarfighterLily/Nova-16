ClrHome
Disp "Memory Functions Test"

Disp "Testing MEMSET..."
A = MEMSET(8192, 170, 10)
Disp "MEMSET completed"

Disp "Testing MEMTEST..."
B = MEMTEST(8192, 8448, 10)
Disp "MEMTEST not equal:", B

MEMSET(8448, 170, 10)
C = MEMTEST(8192, 8448, 10)
Disp "MEMTEST equal:", C

Disp "Testing MEMMOVE..."
MEMSET(8704, 17, 5)
D = MEMMOVE(8960, 8704, 5)
E = MEMTEST(8704, 8960, 5)
Disp "MEMMOVE result:", E

Disp "All memory tests completed!"
Pause
End