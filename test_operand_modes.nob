; Test program to exercise all Nova-16 operand addressing modes
; This tests direct, immediate, indirect, and indexed addressing

ClrHome

; Test immediate addressing
A = 42          ; MOV P0,42 (immediate 8-bit)
B = 1000        ; MOV P0,1000 (immediate 16-bit)

; Test direct addressing for variables
C = A + B       ; Load A and B using direct addressing [0x2000], [0x2002]

; Test list operations (uses indexed addressing via LEA)
L1(0) = 10
L1(1) = 20
L1(2) = L1(0) + L1(1)  ; Uses indirect addressing [P2] for list access

Disp "All addressing modes tested successfully"