REM Color Palette Demo for NoBASIC
REM Demonstrates the full 256-color palette of Nova-16

CLRHOME

REM Display color ramps
FOR RAMP = 0 TO 15
    FOR SHADE = 0 TO 15
        X = SHADE * 8
        Y = RAMP * 8
        COLOR = COLOR(RAMP, SHADE)
        PXLON(X, Y, COLOR)
    NEXT SHADE
NEXT RAMP

REM Display named colors
DISP "Named Colors:"
Y = 140
PXLON(10, Y, BLACK)
DISP "BLACK"
PXLON(10, Y+10, WHITE)
DISP "WHITE"
PXLON(10, Y+20, RED)
DISP "RED"
PXLON(10, Y+30, GREEN)
DISP "GREEN"
PXLON(10, Y+40, BLUE)
DISP "BLUE"
PXLON(10, Y+50, YELLOW)
DISP "YELLOW"
PXLON(10, Y+60, CYAN)
DISP "CYAN"
PXLON(10, Y+70, MAGENTA)
DISP "MAGENTA"

REM Draw some shapes with different colors
LINE(200, 10, 250, 60, ORANGE)
CIRCLE(225, 100, 20, PURPLE)
CIRCLE(225, 100, 15, LIGHTBLUE, 1)  REM Filled circle

REM Demonstrate color extraction
TEST_COLOR = COLOR(5, 10)  REM Magenta ramp, shade 10
DISP "Test color: " + STR(TEST_COLOR)
DISP "Ramp: " + STR(RAMP(TEST_COLOR))
DISP "Shade: " + STR(SHADE(TEST_COLOR))

PAUSE