REM Test bitwise operations
REM Tests AND, OR, XOR, NOT, SHL, SHR operations

ClrHome
Disp "Testing bitwise operations"

REM Test bitwise AND
A = 12  REM 1100 in binary
B = 10  REM 1010 in binary
C = A AND B  REM Should be 8 (1000)
Disp "12 AND 10 =", C

REM Test bitwise OR
D = A OR B  REM Should be 14 (1110)
Disp "12 OR 10 =", D

REM Test bitwise XOR
E = A XOR B  REM Should be 6 (0110)
Disp "12 XOR 10 =", E

REM Test bitwise NOT
F = NOT 5  REM NOT 00000101 = 11111010 (but in 16-bit context)
Disp "NOT 5 =", F

REM Test shift left
G = 3 SHL 2  REM 3 << 2 = 12
Disp "3 SHL 2 =", G

REM Test shift right
H = 12 SHR 2  REM 12 >> 2 = 3
Disp "12 SHR 2 =", H

REM Test combinations
I = (A AND B) OR (C XOR D)
Disp "Complex bitwise =", I

Disp "Bitwise operations test complete"