ClrHome
Disp "Graphics Test Suite"

// Test Line command
Line(10,10,100,50,7)
Line(110,10,200,50,4)

// Test Circle command
Circle(50,100,20,2,1)  // Filled circle
Circle(150,100,15,3,0) // Outline circle

// Test pixel operations
PxlOn(250,20,5)
PxlOff(250,30)
PxlChange(250,40)

// Test Pt operations (same as Pxl)
PtOn(260,20,6)
PtOff(260,30)
PtChange(260,40)

Disp "Graphics operations completed"
Pause
End