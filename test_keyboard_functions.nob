REM Test keyboard input functions
CLRHOME
DISP "Testing KEYIN/KEYSTAT functions"

REM Test KEYSTAT (should return 0 in headless mode)
A = KEYSTAT()
DISP "KEYSTAT() = ", A

REM Test KEYIN (may return 0 in headless mode)
B = KEYIN()
DISP "KEYIN() = ", B

REM Test that functions compile and run
DISP "Keyboard functions work!"
PAUSE
END